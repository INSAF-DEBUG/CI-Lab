pipeline {

    agent {
        label 'jenkins-k8s'
    }

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    parameters {
        string(
            name: 'IMAGE_TAG',
            defaultValue: '',
            description: 'Numéro du build CI ayant publié l’image Docker'
        )
    }

    environment {
        APP_NAME = 'ci-app'
        APP_DIR = 'ci-app'
        HELM_DIR = 'helm/ci-app'
        DOCKER_IMAGE = 'insafnemri/ci-app'
        GIT_BRANCH = 'main'
        ARGOCD_SERVER = 'ARGOCD_SERVER_A_CONFIGURER'
        VAULT_ADDR = 'http://vault.vault.svc.cluster.local:8200'
        VAULT_AUTH_PATH = 'kubernetes'
        VAULT_ROLE = 'ci-app'
    }

    stages {

        stage('Checkout Git') {
            steps {
                checkout scm
                echo "Code source récupéré depuis GitHub."
            }
        }

        stage('Validation du tag Docker') {
            steps {
                script {
                    if (!params.IMAGE_TAG?.trim()) {
                        error("Le paramètre IMAGE_TAG est obligatoire.")
                    }

                    if (!(params.IMAGE_TAG ==~ /^[A-Za-z0-9_.-]+$/)) {
                        error("Le format du tag Docker est invalide.")
                    }

                    echo "Image à déployer : ${DOCKER_IMAGE}:${params.IMAGE_TAG}"
                }
            }
        }

        stage('Authentification Vault') {
            steps {
                sh '''
                    set -eu

                    JWT_FILE="/var/run/secrets/kubernetes.io/serviceaccount/token"
                    TOKEN_FILE="${WORKSPACE}/.vault-token"

                    if [ ! -r "$JWT_FILE" ]; then
                        echo "Token du ServiceAccount Kubernetes introuvable."
                        exit 1
                    fi

                    JWT=$(cat "$JWT_FILE")

                    RESPONSE=$(curl -sS \
                        --request POST \
                        --data "{\"role\":\"${VAULT_ROLE}\",\"jwt\":\"${JWT}\"}" \
                        "${VAULT_ADDR}/v1/auth/${VAULT_AUTH_PATH}/login")

                    VAULT_TOKEN=$(printf '%s' "$RESPONSE" | sed -n 's/.*"client_token":"\([^"]*\)".*/\1/p')

                    if [ -z "$VAULT_TOKEN" ]; then
                        echo "Échec de l'authentification Vault."
                        exit 1
                    fi

                    umask 077
                    printf '%s' "$VAULT_TOKEN" > "$TOKEN_FILE"

                    unset JWT VAULT_TOKEN RESPONSE

                    echo "Authentification Vault réussie. Token conservé temporairement."
                '''
            }
        }

        stage('Mise à jour du tag Helm') {
            steps {
                dir("${HELM_DIR}") {
                    sh '''
                        set -eu

                        if ! grep -q '^  tag:' values.yaml; then
                            echo "La propriété image.tag est introuvable."
                            exit 1
                        fi

                        sed -i "s/^  tag:.*/  tag: \\"${IMAGE_TAG}\\"/" values.yaml

                        echo "Tag Docker configuré dans Helm :"
                        grep -A 3 '^image:' values.yaml
                    '''
                }
            }
        }

        stage('Commit et Push GitHub') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'github-credentials',
                    usernameVariable: 'GIT_USERNAME',
                    passwordVariable: 'GIT_TOKEN'
                )]) {
                    sh '''
                        set -eu

                        git config user.name "Jenkins"
                        git config user.email "jenkins@localhost"

                        git add helm/ci-app/values.yaml

                        if git diff --cached --quiet; then
                            echo "Aucune modification Helm à publier."
                            exit 0
    

                        git commit -m "Deploy ci-app image ${IMAGE_TAG}"

                        git push https://${GIT_USERNAME}:${GIT_TOKEN}@github.com/INSAF-DEBUG/CI-Lab.git HEAD:${GIT_BRANCH}
                    '''
                }
            }
        }

        stage('Synchronisation Argo CD') {
            steps {
                withCredentials([string(
                    credentialsId: 'argocd-token',
                    variable: 'ARGOCD_AUTH_TOKEN'
                )]) {
                    sh '''
                        set -eu

                        argocd app sync ci-app \
                            --server "$ARGOCD_SERVER" \
                            --auth-token "$ARGOCD_AUTH_TOKEN" \
                            --insecure

                        argocd app wait ci-app \
                            --server "$ARGOCD_SERVER" \
                            --auth-token "$ARGOCD_AUTH_TOKEN" \
                            --health \
                            --sync \
                            --insecure
                    '''
                }
            }
        }

    }

    post {
        always {
            sh '''
                rm -f "${WORKSPACE}/.vault-token"
            '''
        }
    }
}
