pipeline {

    agent {
        label 'jenkins-k8s'
    }

    options {
        timestamps()
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
    }

    environment {
        APP_NAME       = 'ci-app'
        HELM_DIR       = 'helm/ci-app'
        DOCKER_IMAGE   = 'insafnemri/ci-app'
        IMAGE_TAG      = 'latest'
        TARGET_BRANCH  = 'main'

        ARGOCD_SERVER  = 'argocd-server.argocd.svc.cluster.local'

        VAULT_ADDR      = 'http://vault.vault.svc.cluster.local:8200'
        VAULT_AUTH_PATH = 'kubernetes'
        VAULT_ROLE      = 'ci-app'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm

                sh '''
                    echo "Récupération du dépôt terminée."
                    echo "Branche : $(git branch --show-current)"
                    echo "Commit : $(git rev-parse --short HEAD)"
                '''
            }
        }

        stage('Validation de l’image Docker') {
            steps {
                sh '''
                    set -eu

                    echo "Image Docker : ${DOCKER_IMAGE}:${IMAGE_TAG}"

                    if ! printf '%s' "$IMAGE_TAG" | grep -Eq '^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$'; then
                        echo "Tag Docker invalide."
                        exit 1
                    fi

                    echo "Validation de l'image réussie."
                '''
            }
        }

        stage('Authentification Vault') {
            steps {
                sh '''
                    set -eu

                    JWT_FILE="/var/run/secrets/kubernetes.io/serviceaccount/token"
                    TOKEN_FILE="${WORKSPACE}/.vault-token"
                    REQUEST_FILE="${WORKSPACE}/.vault-request.json"
                    RESPONSE_FILE="${WORKSPACE}/.vault-response.json"

                    umask 077
                    trap 'rm -f "$REQUEST_FILE" "$RESPONSE_FILE"' EXIT

                    if [ ! -r "$JWT_FILE" ]; then
                        echo "Token du ServiceAccount Kubernetes introuvable."
                        exit 1
                    fi

                    JWT=$(cat "$JWT_FILE")

                    printf '{"role":"%s","jwt":"%s"}' \
                        "$VAULT_ROLE" "$JWT" > "$REQUEST_FILE"

                    echo "Authentification auprès de Vault..."

                    HTTP_CODE=$(curl -sS \
                        --output "$RESPONSE_FILE" \
                        --write-out '%{http_code}' \
                        --request POST \
                        --header "Content-Type: application/json" \
                        --data-binary "@${REQUEST_FILE}" \
                        "${VAULT_ADDR}/v1/auth/${VAULT_AUTH_PATH}/login")

                    if [ "$HTTP_CODE" != "200" ]; then
                        echo "Échec de l'authentification Vault."
                        echo "Code HTTP : $HTTP_CODE"
                        echo "Réponse Vault :"
                        cat "$RESPONSE_FILE"
                        exit 1
                    fi

                    VAULT_TOKEN=$(grep -o '"client_token"[[:space:]]*:[[:space:]]*"[^"]*"' "$RESPONSE_FILE" | cut -d '"' -f4)

                    if [ -z "$VAULT_TOKEN" ]; then
                        echo "Impossible de récupérer le token Vault."
                        exit 1
                    fi

                    printf '%s' "$VAULT_TOKEN" > "$TOKEN_FILE"
                    chmod 600 "$TOKEN_FILE"

                    unset JWT VAULT_TOKEN

                    echo "Authentification Vault réussie."
                    echo "Token conservé temporairement."
                '''
            }
        }

        stage('Mise à jour du tag Helm') {
            steps {
                sh '''
                    set -eu

                    VALUES_FILE="${HELM_DIR}/values.yaml"

                    if [ ! -f "$VALUES_FILE" ]; then
                        echo "Fichier values.yaml introuvable."
                        exit 1
                    fi

                    echo "Mise à jour du tag Docker dans Helm..."

                    sed -i -E \
                        "s/^([[:space:]]*tag:).*/\\1 ${IMAGE_TAG}/" \
                        "$VALUES_FILE"

                    echo "Tag configuré :"
                    grep -n 'tag:' "$VALUES_FILE"
                '''
            }
        }

        stage('Commit et Push GitHub') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-credentials',
                        usernameVariable: 'GIT_USERNAME',
                        passwordVariable: 'GIT_PASSWORD'
                    )
                ]) {
                    sh '''
                        set -eu
                        set +x

                        git config user.name "Jenkins CI/CD"
                        git config user.email "jenkins@localhost"

                        git add helm/ci-app/values.yaml

                        if git diff --cached --quiet; then
                            echo "Aucune modification Helm à publier."
                            exit 0
                        fi

                        git commit -m "Deploy ci-app image ${IMAGE_TAG}"

                        AUTH_HEADER=$(printf '%s:%s' \
                            "$GIT_USERNAME" "$GIT_PASSWORD" | base64 | tr -d '\\n')

                        git -c http.extraheader="AUTHORIZATION: basic ${AUTH_HEADER}" \
                            push origin "HEAD:${TARGET_BRANCH}"

                        unset AUTH_HEADER GIT_PASSWORD

                        echo "Publication GitHub réussie."
                    '''
                }
            }
        }

        stage('Synchronisation Argo CD') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'argocd-token',
                        variable: 'ARGOCD_AUTH_TOKEN'
                    )
                ]) {
                    container('argocd') {
                        sh '''
                            set -eu
                            set +x

                            echo "Vérification du client Argo CD..."

                            argocd version --client

                            echo "Vérification de l'application..."

                            argocd app get "$APP_NAME" \
                                --server "$ARGOCD_SERVER" \
                                --auth-token "$ARGOCD_AUTH_TOKEN" \
                                --insecure

                            echo "Synchronisation de l'application..."

                            argocd app sync "$APP_NAME" \
                                --server "$ARGOCD_SERVER" \
                                --auth-token "$ARGOCD_AUTH_TOKEN" \
                                --insecure

                            echo "Attente de l'état Healthy et Synced..."

                            argocd app wait "$APP_NAME" \
                                --server "$ARGOCD_SERVER" \
                                --auth-token "$ARGOCD_AUTH_TOKEN" \
                                --insecure \
                                --sync \
                                --health \
                                --timeout 300

                            echo "Déploiement Kubernetes terminé."
                        '''
                    }
                }
            }
        }
    }

    post {
        always {
            sh '''
                rm -f \
                    "${WORKSPACE}/.vault-token" \
                    "${WORKSPACE}/.vault-request.json" \
                    "${WORKSPACE}/.vault-response.json"

                echo "Nettoyage des fichiers temporaires terminé."
            '''
        }

        success {
            echo 'Pipeline CD Kubernetes terminé avec succès.'
        }

        failure {
            echo 'Échec du pipeline CD Kubernetes. Consulter les logs.'
        }
    }
}
