```groovy
pipeline {

    agent {
        label 'jenkins-k8s'
    }

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    environment {
        APP_NAME        = 'ci-app'
        APP_DIR         = 'ci-app'
        HELM_DIR        = 'helm/ci-app'

        DOCKER_IMAGE    = 'insafnemri/ci-app'
        IMAGE_TAG       = 'latest'

        GIT_BRANCH      = 'main'
        GIT_REPO        = 'https://github.com/INSAF-DEBUG/CI-Lab.git'

        VAULT_ADDR      = 'http://vault.vault.svc.cluster.local:8200'
        VAULT_AUTH_PATH = 'kubernetes'
        VAULT_ROLE      = 'ci-app'
        VAULT_SECRET    = 'secret/data/ci-app'

        ARGOCD_SERVER   = 'argocd-server.argocd.svc.cluster.local'
        ARGOCD_VERSION  = 'v3.6.1'
    }

    stages {

        stage('Checkout') {
            steps {
                echo 'Récupération du dépôt GitHub...'

                checkout scm

                sh '''
                    set -eu

                    echo "Branche actuelle :"
                    git branch --show-current

                    echo "Dernier commit :"
                    git log -1 --oneline

                    test -d "$HELM_DIR"
                    test -f "$HELM_DIR/values.yaml"
                '''
            }
        }

        stage('Validation') {
            steps {
                sh '''
                    set -eu

                    echo "Validation des paramètres..."

                    test -n "$APP_NAME"
                    test -n "$DOCKER_IMAGE"
                    test -n "$IMAGE_TAG"

                    echo "Application : $APP_NAME"
                    echo "Image : $DOCKER_IMAGE:$IMAGE_TAG"

                    echo "Validation terminée."
                '''
            }
        }

        stage('Authentification Vault') {
            steps {
                sh '''
                    set -eu
                    set +x

                    echo "Lecture du JWT Kubernetes..."

                    JWT_FILE="/var/run/secrets/kubernetes.io/serviceaccount/token"

                    test -f "$JWT_FILE"

                    K8S_JWT="$(cat "$JWT_FILE")"

                    test -n "$K8S_JWT"

                    echo "Authentification auprès de Vault..."

                    LOGIN_RESPONSE="/tmp/vault-login-${BUILD_NUMBER}.json"

                    curl -fsS \
                        --request POST \
                        --data "{\\"role\\":\\"${VAULT_ROLE}\\",\\"jwt\\":\\"${K8S_JWT}\\"}" \
                        "${VAULT_ADDR}/v1/auth/${VAULT_AUTH_PATH}/login" \
                        -o "$LOGIN_RESPONSE"

                    VAULT_TOKEN="$(sed -n 's/.*"client_token"[[:space:]]*:[[:space:]]*"\\([^"]*\\)".*/\\1/p' "$LOGIN_RESPONSE")"

                    test -n "$VAULT_TOKEN"

                    echo "Authentification Vault réussie."

                    echo "Lecture du secret de l'application..."

                    SECRET_RESPONSE="/tmp/vault-secret-${BUILD_NUMBER}.json"

                    curl -fsS \
                        --header "X-Vault-Token: ${VAULT_TOKEN}" \
                        "${VAULT_ADDR}/v1/${VAULT_SECRET}" \
                        -o "$SECRET_RESPONSE"

                    grep -q '"data"' "$SECRET_RESPONSE"

                    echo "Lecture du secret Vault réussie."

                    rm -f "$LOGIN_RESPONSE" "$SECRET_RESPONSE"

                    unset K8S_JWT
                    unset VAULT_TOKEN
                '''
            }
        }

        stage('Mise à jour Helm') {
            steps {
                sh '''
                    set -eu

                    VALUES_FILE="${HELM_DIR}/values.yaml"

                    echo "Mise à jour du tag Docker dans Helm..."

                    test -f "$VALUES_FILE"

                    sed -i -E \
                        's/^([[:space:]]*tag:[[:space:]]*).*/\\1"latest"/' \
                        "$VALUES_FILE"

                    echo "Configuration de l'image :"
                    grep -n 'repository:\\|tag:' "$VALUES_FILE"

                    echo "Mise à jour Helm terminée."
                '''
            }
        }

        stage('Publication GitHub') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-credentials',
                        usernameVariable: 'GIT_USERNAME',
                        passwordVariable: 'GIT_TOKEN'
                    )
                ]) {
                    sh '''
                        set -eu
                        set +x

                        echo "Préparation du commit..."

                        git config user.name "Jenkins CI/CD"
                        git config user.email "jenkins@localhost"

                        git add "$HELM_DIR/values.yaml"

                        if git diff --cached --quiet; then
                            echo "Aucune modification Helm à publier."
                        else
                            git commit -m "Update ci-app image tag to ${IMAGE_TAG}"

                            echo "Publication sur GitHub..."

                            AUTH_HEADER="$(printf '%s' "${GIT_USERNAME}:${GIT_TOKEN}" | base64 | tr -d '\\n')"

                            git -c http.extraheader="AUTHORIZATION: basic ${AUTH_HEADER}" \
                                push origin "HEAD:${GIT_BRANCH}"

                            unset AUTH_HEADER

                            echo "Publication GitHub réussie."
                        fi
                    '''
                }
            }
        }

        stage('Synchronisation Argo CD') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'argocd-token',
                        variable: 'ARGOCD_AUTH_TOKEN'
                    )
                ]) {
                    sh '''
                        set -eu
                        set +x

                        umask 077

                        ARGOCD_CLI="/tmp/argocd-cli-${BUILD_NUMBER}"

                        echo "Vérification du token Argo CD..."

                        test -n "$ARGOCD_AUTH_TOKEN"

                        echo "Téléchargement du client Argo CD ${ARGOCD_VERSION}..."

                        curl --http1.1 \
                            --fail \
                            --location \
                            --silent \
                            --show-error \
                            --retry 5 \
                            --retry-all-errors \
                            --retry-delay 3 \
                            --connect-timeout 30 \
                            --max-time 900 \
                            -o "$ARGOCD_CLI" \
                            "https://github.com/argoproj/argo-cd/releases/download/${ARGOCD_VERSION}/argocd-linux-amd64"

                        chmod +x "$ARGOCD_CLI"

                        echo "Vérification du client Argo CD..."

                        "$ARGOCD_CLI" version --client

                        echo "Connexion au serveur Argo CD par token..."

                        echo "Serveur : $ARGOCD_SERVER"

                        echo "Vérification de l'application..."

                        "$ARGOCD_CLI" \
                            --server "$ARGOCD_SERVER" \
                            --auth-token "$ARGOCD_AUTH_TOKEN" \
                            --insecure \
                            --grpc-web \
                            app get "$APP_NAME"

                        echo "Synchronisation de l'application..."

                        "$ARGOCD_CLI" \
                            --server "$ARGOCD_SERVER" \
                            --auth-token "$ARGOCD_AUTH_TOKEN" \
                            --insecure \
                            --grpc-web \
                            app sync "$APP_NAME" \
                            --timeout 300

                        echo "Attente de l'état Healthy..."

                        "$ARGOCD_CLI" \
                            --server "$ARGOCD_SERVER" \
                            --auth-token "$ARGOCD_AUTH_TOKEN" \
                            --insecure \
                            --grpc-web \
                            app wait "$APP_NAME" \
                            --health \
                            --sync \
                            --timeout 300

                        echo "Synchronisation Argo CD terminée."

                        rm -f "$ARGOCD_CLI"
                    '''
                }
            }
        }
    }

    post {

        success {
            echo 'Pipeline CD Kubernetes terminé avec succès.'
            echo 'Application ci-app synchronisée par Argo CD.'
        }

        failure {
            echo 'Échec du pipeline CD Kubernetes.'
            echo 'Consulter les logs du stage en échec.'
        }

        always {
            sh '''
                set +x

                rm -f "/tmp/vault-login-${BUILD_NUMBER}.json"
                rm -f "/tmp/vault-secret-${BUILD_NUMBER}.json"
                rm -f "/tmp/argocd-cli-${BUILD_NUMBER}"

                echo "Nettoyage terminé."
            '''

            echo 'Fin du pipeline.'
        }
    }
}
