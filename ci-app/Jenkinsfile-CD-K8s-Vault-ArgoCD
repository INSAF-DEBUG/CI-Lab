pipeline {

    agent {
        label 'jenkins-k8s'
    }

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    environment {
        APP_NAME = 'ci-app'
        APP_DIR = 'ci-app'
        HELM_DIR = 'helm/ci-app'

        DOCKER_IMAGE = 'insafnemri/ci-app'
        IMAGE_TAG = 'latest'

        GIT_BRANCH = 'main'
        GIT_REPOSITORY = 'https://github.com/INSAF-DEBUG/CI-Lab.git'

        ARGOCD_SERVER = 'argocd-server.argocd.svc.cluster.local'

        VAULT_ADDR = 'http://vault.vault.svc.cluster.local:8200'
        VAULT_AUTH_PATH = 'kubernetes'
        VAULT_ROLE = 'ci-app'
    }

    stages {

        stage('Checkout') {
            steps {
                echo 'Recuperation du projet GitHub...'

                checkout scm

                sh '''
                    set -eu

                    echo "Branche : ${GIT_BRANCH}"
                    echo "Commit : $(git rev-parse --short HEAD)"
                    echo "Workspace : ${WORKSPACE}"
                '''
            }
        }

        stage('Validation de l’image Docker') {
            steps {
                echo 'Validation de l’image Docker...'

                sh '''
                    set -eu

                    echo "Image : ${DOCKER_IMAGE}:${IMAGE_TAG}"

                    if ! printf '%s' "${IMAGE_TAG}" | grep -Eq '^[a-zA-Z0-9_][a-zA-Z0-9_.-]*$'; then
                        echo "ERREUR : tag Docker invalide."
                        exit 1
                    fi

                    echo "Validation du tag reussie."
                '''
            }
        }

        stage('Authentification Vault') {
            steps {
                echo 'Authentification Kubernetes aupres de Vault...'

                sh '''
                    set -eu
                    set +x

                    JWT_FILE="/var/run/secrets/kubernetes.io/serviceaccount/token"

                    if [ ! -f "$JWT_FILE" ]; then
                        echo "ERREUR : token Kubernetes introuvable."
                        exit 1
                    fi

                    K8S_JWT=$(cat "$JWT_FILE")

                    RESPONSE=$(curl -sS --fail \
                        --request POST \
                        --header "Content-Type: application/json" \
                        --data "{\"role\":\"${VAULT_ROLE}\",\"jwt\":\"${K8S_JWT}\"}" \
                        "${VAULT_ADDR}/v1/auth/${VAULT_AUTH_PATH}/login")

                    VAULT_TOKEN=$(printf '%s' "$RESPONSE" | \
                        awk -F'"' '{for(i=1;i<=NF;i++) if($i=="client_token"){print $(i+2); exit}}')

                    unset K8S_JWT RESPONSE

                    if [ -z "$VAULT_TOKEN" ]; then
                        echo "ERREUR : authentification Vault echouee."
                        exit 1
                    fi

                    umask 077
                    printf '%s' "$VAULT_TOKEN" > "${WORKSPACE}/.vault-token"

                    unset VAULT_TOKEN

                    echo "Authentification Vault reussie."
                '''
            }
        }

        stage('Mise a jour Helm') {
            steps {
                echo 'Mise a jour du tag Docker dans Helm...'

                sh '''
                    set -eu

                    VALUES_FILE="${HELM_DIR}/values.yaml"

                    if [ ! -f "$VALUES_FILE" ]; then
                        echo "ERREUR : fichier values.yaml introuvable."
                        exit 1
                    fi

                    sed -i -E \
                        "s/^([[:space:]]*tag:[[:space:]]*).*/\\1\\"${IMAGE_TAG}\\"/" \
                        "$VALUES_FILE"

                    echo "Configuration Helm :"
                    grep -n 'tag:' "$VALUES_FILE"
                '''
            }
        }

        stage('Commit et Push GitHub') {
            steps {
                echo 'Publication des modifications Helm sur GitHub...'

                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-credentials',
                        usernameVariable: 'GIT_USERNAME',
                        passwordVariable: 'GIT_TOKEN'
                    )
                ]) {
                    sh '''
                        set -eu
                        set +x

                        git config user.name "Jenkins"
                        git config user.email "jenkins@localhost"

                        git add "${HELM_DIR}/values.yaml"

                        if git diff --cached --quiet; then
                            echo "Aucune modification Helm a publier."
                        else
                            git commit -m "Update ci-app image tag to ${IMAGE_TAG}"

                            AUTH=$(printf '%s' \
                                "${GIT_USERNAME}:${GIT_TOKEN}" | base64 | tr -d '\\n')

                            git -c http.extraheader="AUTHORIZATION: basic ${AUTH}" \
                                push origin "HEAD:${GIT_BRANCH}"

                            unset AUTH

                            echo "Publication GitHub reussie."
                        fi
                    '''
                }
            }
        }

        stage('Synchronisation Argo CD') {
            steps {
                echo 'Synchronisation de ci-app avec Argo CD...'

                withCredentials([
                    string(
                        credentialsId: 'argocd-token',
                        variable: 'ARGOCD_AUTH_TOKEN'
                    )
                ]) {

                    container('argocd') {

                        sh '''
                            set -eu
                            set +x

                            echo "Verification du client Argo CD..."

                            argocd version --client

                            echo "Verification de l'application..."

                            argocd app get "${APP_NAME}" \
                                --server "${ARGOCD_SERVER}" \
                                --auth-token "${ARGOCD_AUTH_TOKEN}" \
                                --grpc-web \
                                --insecure

                            echo "Synchronisation de l'application..."

                            argocd app sync "${APP_NAME}" \
                                --server "${ARGOCD_SERVER}" \
                                --auth-token "${ARGOCD_AUTH_TOKEN}" \
                                --grpc-web \
                                --insecure

                            echo "Attente de la synchronisation et de la disponibilite..."

                            argocd app wait "${APP_NAME}" \
                                --server "${ARGOCD_SERVER}" \
                                --auth-token "${ARGOCD_AUTH_TOKEN}" \
                                --grpc-web \
                                --insecure \
                                --sync \
                                --health \
                                --timeout 300

                            echo "Synchronisation Argo CD reussie."
                        '''
                    }
                }
            }
        }
    }

    post {

        success {
            echo '''
            ==========================================
                  PIPELINE CD TERMINE AVEC SUCCES
            ==========================================
            Application : ci-app
            Image       : insafnemri/ci-app:latest
            Deploiement : Kubernetes
            GitOps      : Argo CD
            ==========================================
            '''
        }

        failure {
            echo '''
            ==========================================
                    ECHEC DU PIPELINE CD
            ==========================================
            Consultez les logs Jenkins pour identifier
            l'etape qui a echoue.
            ==========================================
            '''
        }

        always {
            sh '''
                rm -f "${WORKSPACE}/.vault-token"
            '''

            echo 'Nettoyage termine.'
        }
    }
}
