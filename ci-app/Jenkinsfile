pipeline {
    agent none

    options {
        timestamps()
        timeout(time: 60, unit: 'MINUTES')
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
    }

    environment {
        GIT_URL        = 'https://github.com/INSAF-DEBUG/CI-Lab.git'
        GIT_BRANCH     = 'main'

        NEXUS_URL      = 'http://192.168.42.128:8081'
        NEXUS_REPO     = 'maven-snapshots'
        NEXUS_GROUP    = 'com.insaf.cilab'
        GROUP_PATH     = 'com/insaf/cilab/ci-app'
        WAR_FILE       = 'ci-app-1.0-SNAPSHOT.war'

        DOCKER_IMAGE   = 'insafnemri/ci-app'
        DOCKER_TAG     = "${BUILD_NUMBER}"

        // CORRECTION : chemin réel du cache pour l'utilisateur docker
        TRIVY_CACHE_DIR = '/home/docker/.cache/trivy'
    }

    stages {

        // ============================================================
        // STAGE 1 : RECUPERATION DU CODE SOURCE
        // ============================================================
        stage('1 - Recuperation du code source') {
            agent {
                label 'centos-build'
            }

            steps {
                deleteDir()

                sh '''
                    set -eu

                    echo "=== Environnement Git ==="
                    whoami
                    git --version

                    echo "=== Initialisation du depot ==="
                    git init
                    git remote add origin "$GIT_URL"

                    echo "=== Recuperation de la branche ==="
                    git fetch origin "$GIT_BRANCH"
                    git checkout -B "$GIT_BRANCH" FETCH_HEAD

                    echo "=== Verification du code ==="
                    git log -1 --oneline
                    test -f ci-app/pom.xml
                    test -f ci-app/Jenkinsfile

                    echo "Code source recupere avec succes."
                '''

                stash(
                    name: 'source-code',
                    includes: 'ci-app/**',
                    excludes: 'ci-app/.git/**'
                )
            }
        }

        // ============================================================
        // STAGE 2 : VERIFICATION JAVA ET MAVEN
        // ============================================================
        stage('2 - Verification Java et Maven') {
            agent {
                label 'centos-build'
            }

            steps {
                unstash 'source-code'

                dir('ci-app') {
                    sh '''
                        set -eu

                        echo "=== Utilisateur ==="
                        whoami

                        echo "=== Version Java ==="
                        java -version

                        echo "=== Version Maven ==="
                        mvn -version

                        echo "=== Verification du projet ==="
                        test -f pom.xml

                        echo "Environnement de build valide."
                    '''
                }
            }
        }

        // ============================================================
        // STAGE 3 : CONSTRUCTION MAVEN
        // ============================================================
        stage('3 - Construction Maven') {
            agent {
                label 'centos-build'
            }

            steps {
                unstash 'source-code'

                dir('ci-app') {
                    sh '''
                        set -eu

                        echo "=== Construction de l'application ==="

                        mvn -B clean package -DskipTests

                        echo "=== Verification du WAR ==="
                        test -f "target/$WAR_FILE"

                        ls -lh "target/$WAR_FILE"

                        echo "Construction Maven terminee."
                    '''
                }

                archiveArtifacts(
                    artifacts: 'ci-app/target/ci-app-1.0-SNAPSHOT.war',
                    fingerprint: true
                )

                stash(
                    name: 'built-war',
                    includes: 'ci-app/target/ci-app-1.0-SNAPSHOT.war'
                )
            }
        }

        // ============================================================
        // STAGE 4 : TESTS ET COUVERTURE JACOCO
        // ============================================================
        stage('4 - Tests et couverture JaCoCo') {
            agent {
                label 'centos-build'
            }

            steps {
                unstash 'source-code'

                dir('ci-app') {
                    sh '''
                        set -eu

                        echo "=== Execution des tests ==="

                        export MOZ_HEADLESS=1

                        mvn -B clean \
                            org.jacoco:jacoco-maven-plugin:0.8.12:prepare-agent \
                            test \
                            org.jacoco:jacoco-maven-plugin:0.8.12:report

                        echo "=== Verification des rapports ==="

                        if [ -d target/surefire-reports ]; then
                            find target/surefire-reports \
                                -maxdepth 1 -type f -print
                        fi

                        if [ -f target/site/jacoco/index.html ]; then
                            echo "Rapport JaCoCo genere."
                        else
                            echo "Attention : rapport JaCoCo absent."
                        fi
                    '''

                    junit(
                        testResults: 'target/surefire-reports/*.xml',
                        allowEmptyResults: false
                    )

                    archiveArtifacts(
                        artifacts: 'target/site/jacoco/**',
                        allowEmptyArchive: true
                    )
                }
            }
        }

        // ============================================================
        // STAGE 5 : PUBLICATION DU WAR DANS NEXUS
        // ============================================================
        stage('5 - Publication du WAR dans Nexus') {
            agent {
                label 'centos-build'
            }

            steps {
                unstash 'built-war'

                withCredentials([
                    usernamePassword(
                        credentialsId: 'nexus-credentials',
                        usernameVariable: 'NEXUS_USER',
                        passwordVariable: 'NEXUS_PASSWORD'
                    )
                ]) {
                    sh '''
                        set -eu

                        echo "=== Verification du WAR ==="
                        test -f "ci-app/target/$WAR_FILE"
                        ls -lh "ci-app/target/$WAR_FILE"

                        echo "=== Preparation des identifiants Maven ==="

                        mkdir -p "$HOME/.m2"

                        cat > "$HOME/.m2/settings.xml" <<EOF
<settings>
  <servers>
    <server>
      <id>nexus-snapshots</id>
      <username>${NEXUS_USER}</username>
      <password>${NEXUS_PASSWORD}</password>
    </server>
  </servers>
</settings>
EOF

                        chmod 600 "$HOME/.m2/settings.xml"

                        echo "=== Publication dans Nexus ==="

                        mvn -B \
                            org.apache.maven.plugins:maven-deploy-plugin:2.8.2:deploy-file \
                            -Dfile="ci-app/target/$WAR_FILE" \
                            -DgroupId="$NEXUS_GROUP" \
                            -DartifactId=ci-app \
                            -Dversion=1.0-SNAPSHOT \
                            -Dpackaging=war \
                            -DgeneratePom=true \
                            -DrepositoryId=nexus-snapshots \
                            -Durl="$NEXUS_URL/repository/$NEXUS_REPO/"

                        echo "Publication Nexus terminee."
                    '''
                }
            }
        }

        // ============================================================
        // STAGE 6 : TELECHARGEMENT DU WAR DEPUIS NEXUS
        // ============================================================
        stage('6 - Recuperation du WAR depuis Nexus') {
            agent {
                label 'centos-build'
            }

            steps {
                sh '''
                    set -eu

                    mkdir -p docker-context

                    echo "=== Recuperation des metadonnees Nexus ==="

                    curl --fail --silent --show-error \
                        "$NEXUS_URL/repository/$NEXUS_REPO/$GROUP_PATH/1.0-SNAPSHOT/maven-metadata.xml" \
                        -o docker-context/maven-metadata.xml

                    echo "=== Identification de la version du WAR ==="

                    SNAPSHOT_VERSION=$(python -c '
import xml.etree.ElementTree as ET

root = ET.parse("docker-context/maven-metadata.xml").getroot()

for item in root.findall(".//snapshotVersion"):
    extension = item.findtext("extension")
    classifier = item.findtext("classifier")
    value = item.findtext("value")

    if extension == "war" and not classifier and value:
        print(value)
        break
')

                    if [ -z "$SNAPSHOT_VERSION" ]; then
                        echo "ERREUR : version du WAR introuvable dans Nexus."
                        exit 1
                    fi

                    echo "Version Nexus trouvee : $SNAPSHOT_VERSION"

                    WAR_URL="$NEXUS_URL/repository/$NEXUS_REPO/$GROUP_PATH/1.0-SNAPSHOT/ci-app-$SNAPSHOT_VERSION.war"

                    echo "=== Telechargement du WAR ==="

                    curl --fail --silent --show-error \
                        "$WAR_URL" \
                        -o "docker-context/$WAR_FILE"

                    test -s "docker-context/$WAR_FILE"
                    ls -lh "docker-context/$WAR_FILE"

                    echo "WAR recupere depuis Nexus."
                '''

                stash(
                    name: 'nexus-war',
                    includes: 'docker-context/**'
                )
            }
        }

        // ============================================================
        // STAGE 7 : CONSTRUCTION DE L'IMAGE DOCKER
        // ============================================================
        stage('7 - Construction de l image Docker') {
            agent {
                label 'docker-trivy'
            }

            steps {
                deleteDir()
                unstash 'nexus-war'

                dir('docker-context') {
                    sh '''
                        set -eu

                        echo "=== Utilisateur Docker ==="
                        whoami
                        id

                        echo "=== Verification du WAR provenant de Nexus ==="
                        test -s "$WAR_FILE"
                        ls -lh "$WAR_FILE"

                        echo "=== Generation du Dockerfile ==="

                        cat > Dockerfile <<'EOF'
FROM tomcat:9.0-jdk8-temurin

RUN rm -rf /usr/local/tomcat/webapps/*

COPY ci-app-1.0-SNAPSHOT.war /usr/local/tomcat/webapps/ROOT.war

EXPOSE 8080

CMD ["catalina.sh", "run"]
EOF

                        echo "=== Construction de l'image ==="

                        docker build \
                            -t "$DOCKER_IMAGE:$DOCKER_TAG" \
                            -t "$DOCKER_IMAGE:latest" \
                            .

                        echo "=== Verification de l'image ==="

                        docker image inspect "$DOCKER_IMAGE:$DOCKER_TAG" \
                            --format 'Image={{.RepoTags}}'

                        docker images "$DOCKER_IMAGE"

                        echo "Image Docker construite."
                    '''
                }
            }
        }

        // ============================================================
        // STAGE 8 : ANALYSE DE SECURITE TRIVY
        // ============================================================
        stage('8 - Analyse de securite Trivy') {
            agent {
                label 'docker-trivy'
            }

            steps {
                sh '''
                    set -eu

                    echo "=== Environnement Jenkins ==="
                    whoami
                    id
                    echo "HOME=$HOME"

                    echo "=== Verification Trivy ==="
                    command -v trivy
                    trivy --version

                    echo "=== Verification du cache ==="
                    echo "TRIVY_CACHE_DIR=$TRIVY_CACHE_DIR"

                    if [ ! -d "$TRIVY_CACHE_DIR/db" ]; then
                        echo "ERREUR : repertoire de base Trivy introuvable :"
                        echo "$TRIVY_CACHE_DIR/db"
                        exit 1
                    fi

                    if [ ! -f "$TRIVY_CACHE_DIR/db/trivy.db" ]; then
                        echo "ERREUR : trivy.db est absent."
                        ls -lah "$TRIVY_CACHE_DIR/db"
                        exit 1
                    fi

                    if [ ! -f "$TRIVY_CACHE_DIR/db/metadata.json" ]; then
                        echo "ERREUR : metadata.json est absent."
                        ls -lah "$TRIVY_CACHE_DIR/db"
                        exit 1
                    fi

                    echo "Base Trivy disponible :"
                    ls -lh "$TRIVY_CACHE_DIR/db/"

                    echo "=== Verification de l'image a analyser ==="

                    docker image inspect "$DOCKER_IMAGE:$DOCKER_TAG" \
                        --format '{{.Id}}'

                    echo "=== Preparation des exceptions documentees ==="

                    cat > .trivyignore <<'EOF'
CVE-2026-78667
CVE-2026-78669
CVE-2026-97031
EOF

                    echo "=== Lancement du scan de vulnerabilites ==="

                    trivy \
                        --cache-dir "$TRIVY_CACHE_DIR" \
                        --timeout 30m \
                        image \
                        --skip-db-update \
                        --skip-java-db-update \
                        --scanners vuln \
                        --ignorefile .trivyignore \
                        --exit-code 1 \
                        --severity CRITICAL,HIGH \
                        "$DOCKER_IMAGE:$DOCKER_TAG"

                    echo "Scan Trivy termine sans vulnerabilite HIGH/CRITICAL bloquante."
                '''
            }
        }

        // ============================================================
        // STAGE 9 : PUBLICATION SUR DOCKER HUB
        // ============================================================
        stage('9 - Publication sur Docker Hub') {
            agent {
                label 'docker-trivy'
            }

            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-credentials',
                        usernameVariable: 'DOCKERHUB_USER',
                        passwordVariable: 'DOCKERHUB_PASSWORD'
                    )
                ]) {
                    sh '''
                        set -eu

                        echo "=== Verification des images locales ==="

                        docker image inspect "$DOCKER_IMAGE:$DOCKER_TAG" \
                            >/dev/null

                        echo "=== Connexion a Docker Hub ==="

                        set +x
                        printf '%s' "$DOCKERHUB_PASSWORD" |
                            docker login \
                                --username "$DOCKERHUB_USER" \
                                --password-stdin
                        set -x

                        echo "=== Publication de la version ==="

                        docker push "$DOCKER_IMAGE:$DOCKER_TAG"

                        echo "=== Publication du tag latest ==="

                        docker push "$DOCKER_IMAGE:latest"

                        echo "=== Deconnexion Docker Hub ==="

                        docker logout

                        echo "Publication Docker Hub terminee."
                    '''
                }
            }
        }

        // ============================================================
        // STAGE 10 : DEPLOIEMENT DOCKER SWARM
        // ============================================================
        stage('10 - Deploiement Docker Swarm') {
            agent {
                label 'docker-trivy'
            }

            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-credentials',
                        usernameVariable: 'DOCKERHUB_USER',
                        passwordVariable: 'DOCKERHUB_PASSWORD'
                    )
                ]) {
                    sh '''
                        set -eu

                        echo "=== Verification de Docker Swarm ==="
                        docker info --format '{{.Swarm.LocalNodeState}}'

                        echo "=== Recuperation de l'image publiee ==="

                        set +x
                        printf '%s' "$DOCKERHUB_PASSWORD" |
                            docker login \
                                --username "$DOCKERHUB_USER" \
                                --password-stdin
                        set -x

                        docker pull "$DOCKER_IMAGE:$DOCKER_TAG"

                        echo "=== Verification du service ==="

                        if docker service inspect app-cd >/dev/null 2>&1; then
                            echo "Le service app-cd existe deja."

                            docker service update \
                                --image "$DOCKER_IMAGE:$DOCKER_TAG" \
                                --with-registry-auth \
                                app-cd
                        else
                            echo "Creation du service app-cd."

                            docker service create \
                                --name app-cd \
                                --publish published=8080,target=8080 \
                                --replicas 2 \
                                --with-registry-auth \
                                "$DOCKER_IMAGE:$DOCKER_TAG"
                        fi

                        echo "=== Etat du service ==="

                        docker service ls
                        docker service ps app-cd

                        docker logout

                        echo "Deploiement Swarm termine."
                    '''
                }
            }
        }
    }

    // ================================================================
    // POST : RESULTAT DU PIPELINE
    // ================================================================
    post {
        success {
            echo 'Pipeline CI/CD termine avec succes.'
            echo "Image publiee : ${DOCKER_IMAGE}:${DOCKER_TAG}"
        }

        failure {
            echo 'ERREUR : le pipeline CI/CD a echoue.'
            echo 'Consultez la console Jenkins pour identifier le stage en erreur.'
        }

        always {
            echo "Fin du build #${BUILD_NUMBER}."
        }
    }
}
