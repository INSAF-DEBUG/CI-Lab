
pipeline {
    agent {
        label 'centos-build'
    }

    options {
        timestamps()
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
        timeout(time: 60, unit: 'MINUTES')
    }

    parameters {
        booleanParam(
            name: 'ENABLE_SONAR',
            defaultValue: false,
            description: 'Activer SonarQube et le Quality Gate'
        )

        booleanParam(
            name: 'ENABLE_JMETER',
            defaultValue: false,
            description: 'Activer les tests de charge JMeter'
        )
    }

    environment {
        APP_DIR = 'ci-app'
        APP_NAME = 'ci-app'
        APP_VERSION = '1.0-SNAPSHOT'

        NEXUS_URL = 'http://192.168.42.128:8081'
        NEXUS_REPO = 'maven-snapshots'

        DOCKERHUB_USER = 'insafnemri'
        DOCKER_IMAGE = 'insafnemri/ci-app'

        WAR_FILE = 'ci-app/target/ci-app-1.0-SNAPSHOT.war'
    }

    stages {

        stage('1 - Checkout Git') {
            steps {
                checkout scm

                sh '''
                    set -e
                    echo "=== Depot Git ==="
                    git log -1 --oneline

                    echo "=== Application ==="
                    ls -la ci-app
                    test -f ci-app/pom.xml
                '''
            }
        }

        stage('2 - Verification Java et Maven') {
            steps {
                sh '''
                    set -e

                    echo "=== Java ==="
                    java -version

                    echo "=== Maven ==="
                    mvn -version

                    echo "=== Outils ==="
                    command -v git
                    command -v mvn
                '''
            }
        }

        stage('3 - Build Maven') {
            steps {
                dir('ci-app') {
                    sh '''
                        set -e
                        mvn -B clean package -DskipTests
                    '''
                }

                sh '''
                    set -e
                    test -s "$WAR_FILE"
                    ls -lh "$WAR_FILE"
                '''
            }
        }

        stage('4 - Tests et couverture JaCoCo') {
            steps {
                dir('ci-app') {
                    sh '''
                        set -e
                        export MOZ_HEADLESS=1

                        mvn -B \
                          org.jacoco:jacoco-maven-plugin:0.8.12:prepare-agent \
                          test \
                          org.jacoco:jacoco-maven-plugin:0.8.12:report

                        test -f target/site/jacoco/index.html
                    '''
                }
            }

            post {
                always {
                    junit(
                        testResults: 'ci-app/target/surefire-reports/*.xml',
                        allowEmptyResults: false
                    )

                    archiveArtifacts(
                        artifacts: 'ci-app/target/site/jacoco/**',
                        allowEmptyArchive: true
                    )
                }
            }
        }

        stage('5 - Analyse SonarQube') {
            when {
                expression {
                    return params.ENABLE_SONAR
                }
            }

            steps {
                dir('ci-app') {
                    withSonarQubeEnv('SonarQube') {
                        sh '''
                            set -e

                            mvn -B sonar:sonar \
                              -Dsonar.coverage.jacoco.xmlReportPaths=target/site/jacoco/jacoco.xml
                        '''
                    }
                }
            }
        }

        stage('6 - Quality Gate') {
            when {
                expression {
                    return params.ENABLE_SONAR
                }
            }

            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate(
                        abortPipeline: true
                    )
                }
            }
        }

        stage('7 - Publication Maven vers Nexus') {
            steps {
                dir('ci-app') {
                    sh '''
                        set -e

                        echo "=== Verification de Nexus ==="

                        curl -fsS \
                          --connect-timeout 10 \
                          "$NEXUS_URL/" \
                          -o /dev/null

                        echo "=== Publication Maven ==="
                        mvn -B deploy -DskipTests
                    '''
                }
            }
        }

        stage('8 - Tests de charge JMeter') {
            when {
                expression {
                    return params.ENABLE_JMETER
                }
            }

            steps {
                sh '''
                    set -e

                    command -v jmeter

                    if [ ! -f tests/jmeter/ci-app.jmx ]; then
                        echo "ERREUR : tests/jmeter/ci-app.jmx est introuvable."
                        echo "Adapte le chemin au fichier JMX existant."
                        exit 1
                    fi

                    mkdir -p reports/jmeter

                    jmeter -n \
                      -t tests/jmeter/ci-app.jmx \
                      -l reports/jmeter/results.jtl \
                      -e \
                      -o reports/jmeter/html-report
                '''
            }

            post {
                always {
                    archiveArtifacts(
                        artifacts: 'reports/jmeter/**',
                        allowEmptyArchive: true
                    )
                }
            }
        }

        stage('9 - Archivage et preparation WAR') {
            steps {
                sh '''
                    set -e
                    test -s "$WAR_FILE"
                    ls -lh "$WAR_FILE"
                '''

                archiveArtifacts(
                    artifacts: 'ci-app/target/ci-app-1.0-SNAPSHOT.war',
                    fingerprint: true
                )

                stash(
                    name: 'ci-app-war',
                    includes: 'ci-app/target/ci-app-1.0-SNAPSHOT.war'
                )
            }
        }

        stage('10 - Docker, Trivy et Docker Hub') {
            agent {
                label 'docker-trivy'
            }

            steps {
                unstash 'ci-app-war'

                sh '''
                    set -e

                    echo "=== Verification Docker ==="
                    docker --version
                    docker info

                    echo "=== Verification Trivy ==="
                    trivy --version

                    test -s "$WAR_FILE"

                    cat > Dockerfile <<'EOF'
FROM tomcat:9.0-jdk21-temurin-noble

LABEL maintainer="Insaf Nemri"
LABEL application="ci-app"

COPY ci-app/target/ci-app-1.0-SNAPSHOT.war \
     /usr/local/tomcat/webapps/ci-app.war

EXPOSE 8080

CMD ["catalina.sh", "run"]
EOF

                    echo "=== Construction de l'image ==="

                    docker build \
                      -t "$DOCKER_IMAGE:$BUILD_NUMBER" \
                      -t "$DOCKER_IMAGE:latest" \
                      .
                '''

                echo '=== Analyse de securite Trivy ==='

                sh '''
                    set -e

                    trivy image \
                      --severity HIGH,CRITICAL \
                      --ignore-unfixed \
                      --exit-code 1 \
                      "$DOCKER_IMAGE:$BUILD_NUMBER"
                '''

                withCredentials([
                    string(
                        credentialsId: 'DOCKERHUB_TOKEN',
                        variable: 'DOCKERHUB_TOKEN'
                    )
                ]) {
                    sh '''
                        set -e

                        echo "=== Connexion Docker Hub ==="

                        echo "$DOCKERHUB_TOKEN" |
                          docker login \
                            -u "$DOCKERHUB_USER" \
                            --password-stdin

                        # Trois tentatives maximum par tag
                        for tag in "$BUILD_NUMBER" latest; do
                            attempt=1

                            while true; do
                                echo "Publication de $DOCKER_IMAGE:$tag - tentative $attempt/3"

                                if docker push "$DOCKER_IMAGE:$tag"; then
                                    echo "Publication reussie : $DOCKER_IMAGE:$tag"
                                    break
                                fi

                                if [ "$attempt" -ge 3 ]; then
                                    echo "ERREUR : publication impossible apres 3 tentatives."
                                    docker logout || true
                                    exit 1
                                fi

                                attempt=$((attempt + 1))
                                echo "Erreur temporaire possible. Attente de 15 secondes..."
                                sleep 15
                            done
                        done

                        docker logout
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'Pipeline CI/CD termine avec succes.'
        }

        failure {
            echo 'Pipeline en echec. Consulter la Console Output pour identifier l etape fautive.'
        }

        always {
            echo 'Fin du pipeline.'
            cleanWs()
        }
    }
}
