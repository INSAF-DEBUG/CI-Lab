pipeline {

    agent {
        label 'centos-build'
    }

    environment {
        JAVA_HOME = '/opt/java/jdk-21.0.4+7'
        PATH = "${JAVA_HOME}/bin:${env.PATH}"

        SONAR_PROJECT_KEY = 'com.insaf.cilab:ci-app'
        SONAR_PROJECT_NAME = 'ci-app'

        EMAIL_TO = 'nemriinsaf000@gmail.com'
    }

    stages {

        stage('Checkout') {
            steps {
                echo '=== Checkout Git ==='
                checkout scm
            }
        }

        stage('Check Java / Maven') {
            steps {
                sh '''
                    set -e

                    echo "=== JAVA_HOME ==="
                    echo "$JAVA_HOME"

                    echo "=== Java ==="
                    which java
                    java -version

                    echo "=== Maven ==="
                    which mvn
                    mvn -version
                '''
            }
        }

        stage('Build') {
            steps {
                echo '=== Build Maven ==='

                dir('ci-app') {
                    sh '''
                        set -e

                        echo "=== POM ==="
                        ls -l pom.xml

                        echo "=== Maven Build ==="
                        mvn clean package -DskipTests
                    '''
                }
            }
        }

        stage('Tests') {
            steps {
                echo '=== Tests Maven ==='

                dir('ci-app') {
                    sh '''
                        set -e

                        export MOZ_HEADLESS=1

                        echo "=== Maven Tests ==="
                        mvn test
                    '''
                }
            }

            post {
                always {
                    junit(
                        allowEmptyResults: true,
                        testResults: 'ci-app/target/surefire-reports/*.xml'
                    )
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                echo '=== Analyse SonarQube ==='

                dir('ci-app') {
                    withSonarQubeEnv('SonarQube') {
                        sh '''
                            set -e

                            echo "=== Java pour SonarQube ==="
                            echo "JAVA_HOME=$JAVA_HOME"
                            java -version

                            echo "=== Maven ==="
                            mvn -version

                            echo "=== SonarQube ==="

                            mvn sonar:sonar \
                              -Dsonar.projectKey="$SONAR_PROJECT_KEY" \
                              -Dsonar.projectName="$SONAR_PROJECT_NAME" \
                              -Dsonar.sources=src/main/java \
                              -Dsonar.tests=src/test/java \
                              -Dsonar.exclusions="**/target/**,**/*.js,**/*.ts,**/*.css,**/src/main/webapp/**" \
                              -Dsonar.coverage.jacoco.xmlReportPaths=target/site/jacoco/jacoco.xml
                        '''
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                echo '=== Quality Gate SonarQube ==='

                timeout(time: 10, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Deploy to Nexus') {
            steps {
                echo '=== Deploy vers Nexus ==='

                dir('ci-app') {
                    sh '''
                        set -e

                        echo "=== Vérification du WAR ==="
                        ls -lh target/*.war

                        echo "=== Deploy Maven ==="
                        mvn deploy -DskipTests
                    '''
                }
            }
        }

        stage('JMeter Load Test') {
            steps {
                echo '=== JMeter Load Test ==='

                script {
                    if (fileExists('ci-app/jmeter')) {
                        dir('ci-app') {
                            sh '''
                                set -e

                                echo "=== Recherche JMeter ==="

                                if command -v jmeter >/dev/null 2>&1; then
                                    jmeter --version

                                    mkdir -p target

                                    found=0

                                    for file in jmeter/*.jmx; do
                                        if [ -f "$file" ]; then
                                            found=1

                                            echo "=== Exécution de $file ==="

                                            jmeter \
                                              -n \
                                              -t "$file" \
                                              -l "target/jmeter-results.jtl"
                                        fi
                                    done

                                    if [ "$found" -eq 0 ]; then
                                        echo "Aucun fichier JMX trouvé."
                                    fi
                                else
                                    echo "JMeter non installé."
                                    echo "Étape ignorée."
                                fi
                            '''
                        }
                    } else {
                        echo 'Répertoire jmeter absent - étape ignorée.'
                    }
                }
            }
        }

        stage('Archive') {
            steps {
                echo '=== Archive des artefacts ==='

                archiveArtifacts(
                    artifacts: 'ci-app/target/*.war',
                    fingerprint: true,
                    allowEmptyArchive: false
                )

                archiveArtifacts(
                    artifacts: 'ci-app/target/site/jacoco/**',
                    fingerprint: true,
                    allowEmptyArchive: true
                )

                archiveArtifacts(
                    artifacts: 'ci-app/target/surefire-reports/**',
                    fingerprint: true,
                    allowEmptyArchive: true
                )

                archiveArtifacts(
                    artifacts: 'ci-app/target/jmeter-results.jtl',
                    fingerprint: true,
                    allowEmptyArchive: true
                )
            }
        }
    }

    post {

        success {
            echo '=== CI SUCCESS ==='

            emailext(
                to: "${EMAIL_TO}",
                subject: "[SUCCESS] ${JOB_NAME} - Build #${BUILD_NUMBER}",
                mimeType: 'text/html',
                body: """
                    <h2 style="color: green;">Pipeline réussi</h2>

                    <p>Bonjour,</p>

                    <p>Le pipeline Jenkins a terminé avec succès.</p>

                    <ul>
                        <li><b>Projet :</b> ${JOB_NAME}</li>
                        <li><b>Build :</b> #${BUILD_NUMBER}</li>
                        <li><b>Statut :</b> SUCCESS</li>
                    </ul>

                    <p>
                        <a href="${BUILD_URL}">
                            Consulter le build Jenkins
                        </a>
                    </p>

                    <p>
                        Les artefacts sont disponibles dans la section
                        Artifacts du build.
                    </p>
                """
            )
        }

        failure {
            echo '=== CI FAILURE ==='

            emailext(
                to: "${EMAIL_TO}",
                subject: "[FAILURE] ${JOB_NAME} - Build #${BUILD_NUMBER}",
                mimeType: 'text/html',
                body: """
                    <h2 style="color: red;">Échec du pipeline</h2>

                    <p>Bonjour,</p>

                    <p>Le pipeline Jenkins a échoué.</p>

                    <ul>
                        <li><b>Projet :</b> ${JOB_NAME}</li>
                        <li><b>Build :</b> #${BUILD_NUMBER}</li>
                        <li><b>Statut :</b> FAILURE</li>
                    </ul>

                    <p>
                        <a href="${BUILD_URL}console">
                            Consulter les logs Jenkins
                        </a>
                    </p>
                """
            )
        }

        unstable {
            echo '=== CI UNSTABLE ==='

            emailext(
                to: "${EMAIL_TO}",
                subject: "[UNSTABLE] ${JOB_NAME} - Build #${BUILD_NUMBER}",
                mimeType: 'text/html',
                body: """
                    <h2 style="color: orange;">Pipeline instable</h2>

                    <p>Le build Jenkins est terminé avec le statut UNSTABLE.</p>

                    <ul>
                        <li><b>Projet :</b> ${JOB_NAME}</li>
                        <li><b>Build :</b> #${BUILD_NUMBER}</li>
                        <li><b>Statut :</b> UNSTABLE</li>
                    </ul>

                    <p>
                        <a href="${BUILD_URL}">
                            Consulter le build Jenkins
                        </a>
                    </p>
                """
            )
        }

        always {
            echo '=== Pipeline terminé ==='
            echo '=== Cleanup ==='

            cleanWs(
                deleteDirs: true,
                disableDeferredWipeout: true,
                notFailBuild: true
            )
        }
    }
}
