pipeline {

    agent any

    environment {
        JAVA_HOME = '/opt/java/jdk-21.0.4+7'
        PATH = "${JAVA_HOME}/bin:${env.PATH}"
    }

    stages {

        stage('Checkout') {
            steps {
                echo '=== Checkout Git ==='
                checkout scm
            }
        }

        stage('Check Java') {
            steps {
                echo '=== Vérification Java / Maven ==='

                sh '''
                    echo "=== JAVA_HOME ==="
                    echo "$JAVA_HOME"

                    echo "=== which java ==="
                    which java

                    echo "=== Java version ==="
                    java -version

                    echo "=== which javac ==="
                    which javac

                    echo "=== Maven ==="
                    which mvn
                    mvn -version
                '''
            }
        }

        stage('Build') {
            steps {
                echo '=== Build Maven ==='

                dir('ci-app') {
                    sh 'mvn clean package -DskipTests'
                }
            }
        }

        stage('Tests') {
            steps {
                echo '=== Tests Maven ==='

                dir('ci-app') {
                    sh '''
                        export MOZ_HEADLESS=1
                        MOZ_HEADLESS=1 mvn test
                    '''
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                echo '=== Analyse SonarQube ==='

                dir('ci-app') {
                    withSonarQubeEnv('SonarQube') {
                        sh '''
                            echo "=== Java utilisé pour SonarQube ==="
                            echo "JAVA_HOME=$JAVA_HOME"
                            java -version

                            echo "=== Maven utilisé pour SonarQube ==="
                            mvn -version

                            echo "=== Analyse SonarQube ==="

                            mvn sonar:sonar \
                              -Dsonar.exclusions="**/target/**"
                        '''
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                echo '=== Quality Gate SonarQube ==='

                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Deploy to Nexus') {
            steps {
                echo '=== Deploy vers Nexus ==='

                dir('ci-app') {
                    sh 'mvn deploy -DskipTests'
                }
            }
        }

        stage('JMeter Load Test') {
            steps {
                echo '=== Test de charge JMeter ==='

                sh '''
                    echo "=== JMeter Load Test ==="
                    echo "Test JMeter à exécuter selon la configuration du projet"
                '''
            }
        }

        stage('Archive') {
            steps {
                echo '=== Archivage ==='

                archiveArtifacts artifacts: 'ci-app/target/*.war',
                                 fingerprint: true,
                                 allowEmptyArchive: true
            }
        }
    }

    post {
        always {
            echo '=== Pipeline terminé ==='

            junit(
                testResults: 'ci-app/target/surefire-reports/*.xml',
                allowEmptyResults: true
            )
        }

        success {
            echo '=== CI SUCCESS ==='
            echo 'Le pipeline a réussi.'
        }

        failure {
            echo '=== CI FAILURE ==='
            echo 'Le pipeline a échoué.'
        }
    }
}

