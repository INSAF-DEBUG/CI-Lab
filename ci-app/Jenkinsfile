pipeline {

    agent {
        label 'centos-build'
    }

    options {
        skipDefaultCheckout(true)
    }

    environment {
        JAVA_HOME = '/opt/java/jdk-21.0.4+7'
        PATH = "${JAVA_HOME}/bin:${env.PATH}"

        SONAR_PROJECT_KEY = 'com.insaf.cilab:ci-app'
        SONAR_PROJECT_NAME = 'ci-app'

        NEXUS_URL = 'http://192.168.42.128:8081'
        NEXUS_REPOSITORY = 'maven-snapshots'
        NEXUS_GROUP_PATH = 'com/insaf/cilab'
        NEXUS_ARTIFACT_ID = 'ci-app'
        NEXUS_VERSION = '1.0-SNAPSHOT'
        WAR_FILE = 'ci-app-1.0-SNAPSHOT.war'

        EMAIL_TO = 'nemriinsaf000@gmail.com'
    }

    stages {

        stage('Checkout') {
            steps {
                echo '=== Checkout Git ==='
                checkout scm
            }
        }

        stage('Check Java / Maven') {
            steps {
                sh '''
                    set -e

                    echo "=== JAVA_HOME ==="
                    echo "$JAVA_HOME"

                    echo "=== Java ==="
                    which java
                    java -version

                    echo "=== Maven ==="
                    which mvn
                    mvn -version
                '''
            }
        }

        stage('Build') {
            steps {
                echo '=== Build Maven ==='

                dir('ci-app') {
                    sh '''
                        set -e

                        test -f pom.xml

                        mvn clean package -DskipTests

                        test -f target/ci-app-1.0-SNAPSHOT.war

                        ls -lh target/ci-app-1.0-SNAPSHOT.war
                    '''
                }
            }
        }

        stage('Tests') {
            steps {
                echo '=== Tests Maven ==='

                dir('ci-app') {
                    sh '''
                        set -e
                        export MOZ_HEADLESS=1

                        mvn test
                    '''
                }
            }

            post {
                always {
                    junit(
                        allowEmptyResults: true,
                        testResults: 'ci-app/target/surefire-reports/*.xml'
                    )
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                echo '=== Analyse SonarQube ==='

                dir('ci-app') {
                    withSonarQubeEnv('SonarQube') {
                        sh '''
                            set -e

                            mvn sonar:sonar \
                              -Dsonar.projectKey="$SONAR_PROJECT_KEY" \
                              -Dsonar.projectName="$SONAR_PROJECT_NAME" \
                              -Dsonar.sources=src/main/java \
                              -Dsonar.tests=src/test/java \
                              -Dsonar.exclusions="**/target/**,**/*.js,**/*.ts,**/*.css,**/src/main/webapp/**" \
                              -Dsonar.coverage.jacoco.xmlReportPaths=target/site/jacoco/jacoco.xml
                        '''
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                echo '=== Quality Gate SonarQube ==='

                timeout(time: 10, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Deploy to Nexus') {
            steps {
                echo '=== Publication du WAR dans Nexus ==='

                dir('ci-app') {
                    sh '''
                        set -e

                        test -f target/ci-app-1.0-SNAPSHOT.war

                        mvn deploy -DskipTests

                        echo "=== WAR publie dans Nexus ==="
                    '''
                }
            }
        }

        stage('JMeter Load Test') {
            steps {
                echo '=== JMeter Load Test ==='

                script {
                    if (fileExists('ci-app/jmeter')) {
                        dir('ci-app') {
                            sh '''
                                set -e

                                if command -v jmeter >/dev/null 2>&1; then
                                    jmeter --version

                                    mkdir -p target
                                    found=0

                                    for file in jmeter/*.jmx; do
                                        if [ -f "$file" ]; then
                                            found=1

                                            echo "=== Execution de $file ==="

                                            jmeter \
                                              -n \
                                              -t "$file" \
                                              -l "target/jmeter-results.jtl"
                                        fi
                                    done

                                    if [ "$found" -eq 0 ]; then
                                        echo "Aucun fichier JMX trouve."
                                    fi
                                else
                                    echo "JMeter non installe : etape ignoree."
                                fi
                            '''
                        }
                    } else {
                        echo 'Repertoire jmeter absent : etape ignoree.'
                    }
                }
            }
        }

        stage('Archive') {
            steps {
                echo '=== Archivage des artefacts ==='

                archiveArtifacts(
                    artifacts: 'ci-app/target/*.war',
                    fingerprint: true,
                    allowEmptyArchive: false
                )

                archiveArtifacts(
                    artifacts: 'ci-app/target/site/jacoco/**',
                    fingerprint: true,
                    allowEmptyArchive: true
                )

                archiveArtifacts(
                    artifacts: 'ci-app/target/surefire-reports/**',
                    fingerprint: true,
                    allowEmptyArchive: true
                )

                archiveArtifacts(
                    artifacts: 'ci-app/target/jmeter-results.jtl',
                    fingerprint: true,
                    allowEmptyArchive: true
                )
            }
        }

        stage('Docker Build, Trivy Scan and Docker Hub Push') {

            agent {
                label 'docker-trivy'
            }

            steps {
                echo '=== Recuperation Nexus, Docker Build, Trivy et Docker Hub ==='

                deleteDir()

                withCredentials([
                    usernamePassword(
                        credentialsId: 'nexus-credentials',
                        usernameVariable: 'NEXUS_USER',
                        passwordVariable: 'NEXUS_PASSWORD'
                    )
                ]) {

                    sh '''
                        set -eu

                        mkdir -p ci-app/target

                        METADATA_URL="${NEXUS_URL}/repository/${NEXUS_REPOSITORY}/${NEXUS_GROUP_PATH}/${NEXUS_ARTIFACT_ID}/${NEXUS_VERSION}/maven-metadata.xml"

                        echo "=== Lecture des metadonnees Nexus ==="

                        curl --fail --silent --show-error \
                          --user "$NEXUS_USER:$NEXUS_PASSWORD" \
                          --output /tmp/maven-metadata.xml \
                          "$METADATA_URL"

                        echo "=== Resolution du dernier snapshot WAR ==="

                        SNAPSHOT_VERSION="$(
                            python -c '
import xml.etree.ElementTree as ET

root = ET.parse("/tmp/maven-metadata.xml").getroot()
ns = {"m": root.tag.split("}")[0].strip("{")} if "}" in root.tag else {}

nodes = (
    root.findall(".//m:snapshotVersion", ns)
    if ns else root.findall(".//snapshotVersion")
)

for node in nodes:
    ext = (
        node.findtext("m:extension", default="", namespaces=ns)
        if ns else node.findtext("extension", default="")
    )

    classifier = (
        node.findtext("m:classifier", default="", namespaces=ns)
        if ns else node.findtext("classifier", default="")
    )

    value = (
        node.findtext("m:value", default="", namespaces=ns)
        if ns else node.findtext("value", default="")
    )

    if ext == "war" and not classifier and value:
        print(value)
        break
'
                        )"

                        if [ -z "$SNAPSHOT_VERSION" ]; then
                            echo "ERREUR : aucun snapshot WAR trouve dans Nexus."
                            exit 1
                        fi

                        echo "Snapshot trouve : $SNAPSHOT_VERSION"

                        WAR_URL="${NEXUS_URL}/repository/${NEXUS_REPOSITORY}/${NEXUS_GROUP_PATH}/${NEXUS_ARTIFACT_ID}/${NEXUS_VERSION}/${NEXUS_ARTIFACT_ID}-${SNAPSHOT_VERSION}.war"

                        echo "=== Telechargement du WAR depuis Nexus ==="

                        curl --fail --silent --show-error \
                          --user "$NEXUS_USER:$NEXUS_PASSWORD" \
                          --output "ci-app/target/$WAR_FILE" \
                          "$WAR_URL"

                        test -s "ci-app/target/$WAR_FILE"

                        ls -lh "ci-app/target/$WAR_FILE"
                    '''
                }

                sh '''
                    set -eu

                    cat > Dockerfile <<'EOF'
FROM tomcat:9.0-jdk21-temurin-noble

RUN rm -rf /usr/local/tomcat/webapps/* \
    && groupadd --system tomcat \
    && useradd --system --gid tomcat \
       --home-dir /usr/local/tomcat \
       --no-create-home tomcat \
    && chown -R tomcat:tomcat /usr/local/tomcat

COPY --chown=tomcat:tomcat ci-app/target/ci-app-1.0-SNAPSHOT.war /usr/local/tomcat/webapps/ci-app.war

EXPOSE 8080

USER tomcat

HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
    CMD bash -c 'cat < /dev/null > /dev/tcp/127.0.0.1/8080' || exit 1

CMD ["catalina.sh", "run"]
EOF

                    echo "=== Dockerfile genere ==="
                    cat Dockerfile
                '''

                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-credentials',
                        usernameVariable: 'DOCKERHUB_USER',
                        passwordVariable: 'DOCKERHUB_TOKEN'
                    )
                ]) {

                    sh '''
                        set -eu

                        IMAGE="$(printf '%s' "$DOCKERHUB_USER" | tr '[:upper:]' '[:lower:]')/ci-app"
                        BUILD_TAG="$IMAGE:$BUILD_NUMBER"

                        echo "=== Construction de $BUILD_TAG ==="

                        docker build \
                            --pull \
                            -t "$BUILD_TAG" \
                            -t "$IMAGE:latest" \
                            .

                        echo "=== Scan Trivy HIGH / CRITICAL ==="

                        trivy image \
                            --timeout 15m \
                            --severity HIGH,CRITICAL \
                            --ignore-unfixed \
                            --exit-code 1 \
                            "$BUILD_TAG"

                        echo "=== Connexion Docker Hub ==="

                        echo "$DOCKERHUB_TOKEN" |
                            docker login \
                              --username "$DOCKERHUB_USER" \
                              --password-stdin

                        echo "=== Publication Docker Hub ==="

                        docker push "$BUILD_TAG"
                        docker push "$IMAGE:latest"

                        docker logout
                    '''
                }
            }

            post {
                always {
                    echo '=== Fin de l etape Docker / Trivy ==='
                }
            }
        }
    }

    post {

        success {
            echo '=== CI SUCCESS ==='
        }

        failure {
            echo '=== CI FAILURE ==='
        }

        unstable {
            echo '=== CI UNSTABLE ==='
        }

        aborted {
            echo '=== CI ABORTED ==='
        }

        always {

            /*
            Notification email desactivee temporairement.
            A reactiver apres correction.
            */

            echo '=== Pipeline termine ==='

            cleanWs(
                deleteDirs: true,
                disableDeferredWipeout: true,
                notFailBuild: true
            )
        }
    }
}
