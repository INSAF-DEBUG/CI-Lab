pipeline {

    agent {
        label 'centos-build'
    }

    environment {
    JAVA_HOME = '/opt/java/jdk-17.0.20.1+1'
    PATH = "${JAVA_HOME}/bin:${env.PATH}"
    }


    stages {

        stage('Checkout') {
            steps {
                echo '=== Checkout Git ==='
                checkout scm
            }
        }

        stage('Check Java') {
            steps {
                echo '=== Vérification Java / Maven ==='
                sh '''
                    echo "=== JAVA_HOME ==="
                    echo "$JAVA_HOME"

                    echo "=== which java ==="
                    which java

                    echo "=== Java version ==="
                    java -version

                    echo "=== which javac ==="
                    which javac

                    echo "=== Maven ==="
                    which mvn
                    mvn -version
                '''
            }
        }

        stage('Build') {
            steps {
                echo '=== Build Maven ==='
                sh '''
                    mvn clean package -DskipTests
                '''
            }
        }

        stage('Tests') {
            steps {
                echo '=== Tests Maven ==='
                sh '''
                    export MOZ_HEADLESS=1
                    mvn test
                '''
            }
        }

        stage('SonarQube Analysis') {
            steps {
                echo '=== Analyse SonarQube ==='

                withSonarQubeEnv('SonarQube') {
                    sh '''
                        echo "=== Java utilisé pour SonarQube ==="
                        echo "JAVA_HOME=$JAVA_HOME"
                        java -version

                        echo "=== Maven utilisé pour SonarQube ==="
                        mvn -version

                        echo "=== Analyse SonarQube ==="

                        mvn sonar:sonar \
                          -Dsonar.exclusions="**/target/**,**/*.js,**/*.ts,**/*.css"
                    '''
                }
            }
        }

        stage('Quality Gate') {
            steps {
                echo '=== Quality Gate SonarQube ==='

                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Deploy to Nexus') {
            steps {
                echo '=== Deploy vers Nexus ==='
                sh '''
                    mvn deploy -DskipTests
                '''
            }
        }

        stage('JMeter Load Test') {
            steps {
                echo '=== Test de charge JMeter ==='

                sh '''
                    if command -v jmeter >/dev/null 2>&1; then
                        echo "JMeter trouvé"
                        jmeter --version
                    else
                        echo "JMeter non installé - étape ignorée"
                    fi
                '''
            }
        }

        stage('Archive') {
            steps {
                echo '=== Archivage des artefacts ==='

                archiveArtifacts artifacts: 'target/*.war',
                                 allowEmptyArchive: true

                archiveArtifacts artifacts: 'target/site/jacoco/**/*',
                                 allowEmptyArchive: true
            }
        }
    }

    post {
        always {
            echo '=== Pipeline terminé ==='

            junit(
                testResults: 'target/surefire-reports/*.xml',
                allowEmptyResults: true
            )
        }

        success {
            echo '=== CI SUCCESS ==='
            echo 'Le pipeline a terminé avec succès.'
        }

        failure {
            echo '=== CI FAILURE ==='
            echo 'Le pipeline a échoué.'
        }
    }
}

