pipeline {
    agent {
        label 'centos-build'
    }

    options {
        timestamps()
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
        timeout(time: 60, unit: 'MINUTES')
    }

    parameters {
        booleanParam(
            name: 'ENABLE_SONAR',
            defaultValue: false,
            description: 'Activer SonarQube et Quality Gate'
        )
        booleanParam(
            name: 'ENABLE_JMETER',
            defaultValue: false,
            description: 'Activer les tests de charge JMeter'
        )
        booleanParam(
            name: 'DEPLOY_SWARM',
            defaultValue: true,
            description: 'Deployer sur Docker Swarm'
        )
    }

    environment {
        APP_NAME = 'ci-app'
        APP_VERSION = '1.0-SNAPSHOT'

        NEXUS_URL = 'http://192.168.42.128:8081'
        NEXUS_REPO = 'maven-snapshots'

        DOCKERHUB_USER = 'insafnemri'
        DOCKER_IMAGE = 'insafnemri/ci-app'

        WAR_FILE = 'ci-app/target/ci-app-1.0-SNAPSHOT.war'
        SWARM_SERVICE = 'ci-app'
        SWARM_REPLICAS = '2'
    }

    stages {

        stage('1 - Checkout Git') {
            steps {
                checkout scm

                sh '''
                    set -eu
                    git log -1 --oneline
                    test -f ci-app/pom.xml
                '''
            }
        }

        stage('2 - Verification Java et Maven') {
            steps {
                sh '''
                    set -eu
                    java -version
                    mvn -version
                    command -v git
                    command -v mvn
                '''
            }
        }

        stage('3 - Build Maven') {
            steps {
                dir('ci-app') {
                    sh '''
                        set -eu
                        mvn -B clean package -DskipTests
                        test -s target/ci-app-1.0-SNAPSHOT.war
                    '''
                }

                archiveArtifacts(
                    artifacts: 'ci-app/target/ci-app-1.0-SNAPSHOT.war',
                    fingerprint: true
                )
            }
        }

        stage('4 - Tests et couverture JaCoCo') {
            steps {
                dir('ci-app') {
                    sh '''
                        set -eu
                        export MOZ_HEADLESS=1

                        mvn -B \
                          org.jacoco:jacoco-maven-plugin:0.8.12:prepare-agent \
                          test \
                          org.jacoco:jacoco-maven-plugin:0.8.12:report

                        test -f target/site/jacoco/index.html
                        test -f target/site/jacoco/jacoco.xml
                    '''
                }
            }

            post {
                always {
                    junit(
                        testResults: 'ci-app/target/surefire-reports/*.xml',
                        allowEmptyResults: false
                    )

                    archiveArtifacts(
                        artifacts: 'ci-app/target/site/jacoco/**',
                        allowEmptyArchive: true
                    )
                }
            }
        }

        stage('5 - Analyse SonarQube') {
            when {
                expression {
                    params.ENABLE_SONAR
                }
            }

            steps {
                dir('ci-app') {
                    withSonarQubeEnv('SonarQube') {
                        sh '''
                            set -eu
                            mvn -B sonar:sonar \
                              -Dsonar.coverage.jacoco.xmlReportPaths=target/site/jacoco/jacoco.xml
                        '''
                    }
                }
            }
        }

        stage('6 - Quality Gate') {
            when {
                expression {
                    params.ENABLE_SONAR
                }
            }

            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate(abortPipeline: true)
                }
            }
        }

        stage('7 - Publication Maven vers Nexus') {
            steps {
                dir('ci-app') {
                    withCredentials([
                        usernamePassword(
                            credentialsId: 'nexus-credentials',
                            usernameVariable: 'NEXUS_USER',
                            passwordVariable: 'NEXUS_PASSWORD'
                        )
                    ]) {
                        sh '''
                            set -eu

                            curl -fsS \
                              --connect-timeout 10 \
                              --user "$NEXUS_USER:$NEXUS_PASSWORD" \
                              "$NEXUS_URL/" \
                              -o /dev/null

                            mvn -B deploy -DskipTests
                        '''
                    }
                }
            }
        }

        stage('8 - Tests de charge JMeter') {
            when {
                expression {
                    params.ENABLE_JMETER
                }
            }

            steps {
                sh '''
                    set -eu

                    command -v jmeter
                    test -f tests/jmeter/ci-app.jmx

                    mkdir -p reports/jmeter

                    jmeter -n \
                      -t tests/jmeter/ci-app.jmx \
                      -l reports/jmeter/results.jtl \
                      -e \
                      -o reports/jmeter/html-report
                '''
            }

            post {
                always {
                    archiveArtifacts(
                        artifacts: 'reports/jmeter/**',
                        allowEmptyArchive: true
                    )
                }
            }
        }

        stage('9 - Verification et archivage WAR') {
            steps {
                sh '''
                    set -eu
                    test -s "$WAR_FILE"
                    ls -lh "$WAR_FILE"
                '''

                archiveArtifacts(
                    artifacts: 'ci-app/target/ci-app-1.0-SNAPSHOT.war',
                    fingerprint: true
                )
            }
        }

        stage('10 - Docker, Trivy, Docker Hub et Swarm') {
            agent {
                label 'docker-trivy'
            }

            steps {
                deleteDir()

                // Recuperation du WAR depuis Nexus.
                withCredentials([
                    usernamePassword(
                        credentialsId: 'nexus-credentials',
                        usernameVariable: 'NEXUS_USER',
                        passwordVariable: 'NEXUS_PASSWORD'
                    )
                ]) {
                    sh '''
                        set -eu
                        command -v python3
                        command -v docker
                        command -v trivy
                        command -v curl

                        export WAR_OUTPUT="$PWD/ROOT.war"

                        python3 <<'PYTHON'
import os
import base64
import urllib.request
import xml.etree.ElementTree as ET

base = os.environ["NEXUS_URL"].rstrip("/")
repo = os.environ["NEXUS_REPO"]
user = os.environ["NEXUS_USER"]
password = os.environ["NEXUS_PASSWORD"]

metadata = (
    f"{base}/repository/{repo}/"
    "com/insaf/cilab/ci-app/1.0-SNAPSHOT/maven-metadata.xml"
)

token = base64.b64encode(
    f"{user}:{password}".encode()
).decode()

def get(url):
    request = urllib.request.Request(url)
    request.add_header("Authorization", f"Basic {token}")
    with urllib.request.urlopen(request, timeout=60) as response:
        return response.read()

root = ET.fromstring(get(metadata))
version = None

for item in root.findall(".//snapshotVersion"):
    if (
        item.findtext("extension") == "war"
        and not item.findtext("classifier")
    ):
        version = item.findtext("value")
        break

if not version:
    timestamp = root.findtext(".//snapshot/timestamp")
    build = root.findtext(".//snapshot/buildNumber")
    if timestamp and build:
        version = f"1.0-{timestamp}-{build}"

if not version:
    raise RuntimeError("Version WAR introuvable dans Nexus")

artifact = f"ci-app-{version}.war"
url = (
    f"{base}/repository/{repo}/"
    "com/insaf/cilab/ci-app/1.0-SNAPSHOT/"
    f"{artifact}"
)

data = get(url)

if not data:
    raise RuntimeError("WAR vide")

with open(os.environ["WAR_OUTPUT"], "wb") as output:
    output.write(data)

print(f"WAR recupere depuis Nexus : {artifact}")
print(f"Taille : {len(data)} octets")
PYTHON

                        test -s ROOT.war
                    '''
                }

                // Construction de l'image Docker.
                sh '''
                    set -eu

                    cat > Dockerfile <<'DOCKERFILE'
FROM tomcat:9-jre8
COPY ROOT.war /usr/local/tomcat/webapps/ROOT.war
EXPOSE 8080
DOCKERFILE

                    docker build \
                      --pull \
                      -t "${DOCKER_IMAGE}:${BUILD_NUMBER}" \
                      .

                    docker tag \
                      "${DOCKER_IMAGE}:${BUILD_NUMBER}" \
                      "${DOCKER_IMAGE}:latest"
                '''

                // Scan de securite Trivy.
                sh '''
                    set -eu

                    trivy image \
                      --no-progress \
                      --severity HIGH,CRITICAL \
                      --exit-code 1 \
                      "${DOCKER_IMAGE}:${BUILD_NUMBER}"
                '''

                // Test du conteneur avant publication.
                sh '''
                    set -eu

                    CONTAINER="ci-app-test-${BUILD_NUMBER}"

                    docker rm -f "$CONTAINER" >/dev/null 2>&1 || true

                    cleanup() {
                        docker rm -f "$CONTAINER" >/dev/null 2>&1 || true
                    }

                    trap cleanup EXIT

                    docker run -d \
                      --name "$CONTAINER" \
                      -p 127.0.0.1:18080:8080 \
                      "${DOCKER_IMAGE}:${BUILD_NUMBER}"

                    READY=0

                    for i in $(seq 1 30); do
                        if curl -fsS \
                          http://127.0.0.1:18080/ \
                          -o /dev/null; then
                            READY=1
                            break
                        fi
                        sleep 2
                    done

                    if [ "$READY" -ne 1 ]; then
                        docker logs "$CONTAINER"
                        echo "Le test HTTP a echoue."
                        exit 1
                    fi

                    echo "Test HTTP reussi."
                '''

                // Publication sur Docker Hub.
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-credentials',
                        usernameVariable: 'DH_USER',
                        passwordVariable: 'DH_TOKEN'
                    )
                ]) {
                    sh '''
                        set -eu
                        set +x

                        echo "$DH_TOKEN" | docker login \
                          --username "$DH_USER" \
                          --password-stdin

                        docker push "${DOCKER_IMAGE}:${BUILD_NUMBER}"
                        docker push "${DOCKER_IMAGE}:latest"

                        docker logout
                    '''
                }

                // Deploiement sur Docker Swarm.
                script {
                    if (params.DEPLOY_SWARM) {
                        withCredentials([
                            usernamePassword(
                                credentialsId: 'dockerhub-credentials',
                                usernameVariable: 'DH_USER',
                                passwordVariable: 'DH_TOKEN'
                            )
                        ]) {
                            sh '''
                                set -eu
                                set +x

                                STATE=$(docker info \
                                  --format '{{.Swarm.LocalNodeState}}')

                                MANAGER=$(docker info \
                                  --format '{{.Swarm.ControlAvailable}}')

                                if [ "$STATE" != "active" ] ||
                                   [ "$MANAGER" != "true" ]; then
                                    echo "ERREUR : cet agent doit acceder a un Swarm Manager actif."
                                    exit 1
                                fi

                                echo "$DH_TOKEN" | docker login \
                                  --username "$DH_USER" \
                                  --password-stdin

                                IMAGE="${DOCKER_IMAGE}:${BUILD_NUMBER}"

                                if docker service inspect "$SWARM_SERVICE" \
                                  >/dev/null 2>&1; then

                                    docker service update \
                                      --image "$IMAGE" \
                                      --with-registry-auth \
                                      "$SWARM_SERVICE"

                                else

                                    docker service create \
                                      --name "$SWARM_SERVICE" \
                                      --replicas "$SWARM_REPLICAS" \
                                      --publish published=8080,target=8080 \
                                      --with-registry-auth \
                                      "$IMAGE"
                                fi

                                docker logout
                            '''
                        }

                        // Attendre que les replicas soient prets.
                        sh '''
                            set -eu

                            READY=0

                            for i in $(seq 1 30); do
                                DESIRED=$(docker service inspect \
                                  --format '{{.Spec.Mode.Replicated.Replicas}}' \
                                  "$SWARM_SERVICE")

                                RUNNING=$(docker service ps \
                                  --filter desired-state=running \
                                  --format '{{.CurrentState}}' \
                                  "$SWARM_SERVICE" |
                                  grep -c '^Running' || true)

                                echo "Replicas : $RUNNING / $DESIRED"

                                if [ "$RUNNING" -ge "$DESIRED" ] &&
                                   [ "$DESIRED" -gt 0 ]; then
                                    READY=1
                                    break
                                fi

                                sleep 5
                            done

                            docker service ps "$SWARM_SERVICE"

                            if [ "$READY" -ne 1 ]; then
                                echo "ERREUR : les replicas Swarm ne sont pas tous actifs."
                                exit 1
                            fi

                            echo "Deploiement Docker Swarm reussi."
                        '''
                    }
                }
            }
        }
    }

    post {
        success {
            echo 'Pipeline CI/CD termine avec succes.'
        }

        failure {
            echo 'Pipeline en echec. Consulter la Console Output.'
        }

        always {
            echo 'Fin du pipeline.'
            cleanWs()
        }
    }
}
