
pipeline {

    options {
        skipDefaultCheckout(true)
    }
    agent {
        label 'centos-build'
    }

    environment {
        JAVA_HOME = '/opt/java/jdk-21.0.4+7'
        PATH = "${JAVA_HOME}/bin:${env.PATH}"

        SONAR_PROJECT_KEY = 'com.insaf.cilab:ci-app'
        SONAR_PROJECT_NAME = 'ci-app'

        EMAIL_TO = 'nemriinsaf000@gmail.com'
    }

    stages {

        stage('Checkout') {
            steps {
                echo '=== Checkout Git ==='
                checkout scm
            }
        }

        stage('Check Java / Maven') {
            steps {
                sh '''
                    set -e

                    echo "=== JAVA_HOME ==="
                    echo "$JAVA_HOME"

                    echo "=== Java ==="
                    which java
                    java -version

                    echo "=== Maven ==="
                    which mvn
                    mvn -version
                '''
            }
        }

        stage('Test Email Notification') {
            steps {
                script {
                    echo '=== TEST EMAIL EXTENSION ==='
                    echo "Destinataire : ${env.EMAIL_TO}"

                    emailext(
                        to: env.EMAIL_TO,
                        subject: "[TEST PIPELINE] ${env.JOB_NAME} - Build #${env.BUILD_NUMBER}",
                        mimeType: 'text/plain',
                        body: """
Test d'envoi depuis le pipeline Jenkins.

Projet : ${env.JOB_NAME}
Build : #${env.BUILD_NUMBER}
Statut actuel : ${currentBuild.currentResult}
URL : ${env.BUILD_URL}

Si vous recevez ce message, l'envoi depuis emailext fonctionne.
"""
                    )

                    echo '=== ETAPE EMAIL TEST TERMINEE ==='
                }
            }
        }

        stage('Build') {
            steps {
                echo '=== Build Maven ==='

                dir('ci-app') {
                    sh '''
                        set -e

                        echo "=== POM ==="
                        ls -l pom.xml

                        echo "=== Maven Build ==="
                        mvn clean package -DskipTests
                    '''
                }
            }
        }

        stage('Tests') {
            steps {
                echo '=== Tests Maven ==='

                dir('ci-app') {
                    sh '''
                        set -e
                        export MOZ_HEADLESS=1

                        echo "=== Maven Tests ==="
                        mvn test
                    '''
                }
            }

            post {
                always {
                    junit(
                        allowEmptyResults: true,
                        testResults: 'ci-app/target/surefire-reports/*.xml'
                    )
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                echo '=== Analyse SonarQube ==='

                dir('ci-app') {
                    withSonarQubeEnv('SonarQube') {
                        sh '''
                            set -e

                            echo "=== Java pour SonarQube ==="
                            echo "JAVA_HOME=$JAVA_HOME"
                            java -version

                            echo "=== Maven ==="
                            mvn -version

                            echo "=== SonarQube ==="

                            mvn sonar:sonar \
                              -Dsonar.projectKey="$SONAR_PROJECT_KEY" \
                              -Dsonar.projectName="$SONAR_PROJECT_NAME" \
                              -Dsonar.sources=src/main/java \
                              -Dsonar.tests=src/test/java \
                              -Dsonar.exclusions="**/target/**,**/*.js,**/*.ts,**/*.css,**/src/main/webapp/**" \
                              -Dsonar.coverage.jacoco.xmlReportPaths=target/site/jacoco/jacoco.xml
                        '''
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                echo '=== Quality Gate SonarQube ==='

                timeout(time: 10, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Deploy to Nexus') {
            steps {
                echo '=== Deploy vers Nexus ==='

                dir('ci-app') {
                    sh '''
                        set -e

                        echo "=== Vérification du WAR ==="
                        ls -lh target/*.war

                        echo "=== Deploy Maven ==="
                        mvn deploy -DskipTests
                    '''
                }
            }
        }

        stage('Prepare Docker Artifact') {
            steps {
                echo '=== Préparation de l’artefact pour la VM Docker ==='
                stash(
                    name: 'ci-app-war',
                    includes: 'ci-app/target/ci-app-1.0-SNAPSHOT.war',
                    useDefaultExcludes: false
                )
            }
        }

        stage('JMeter Load Test') {
            steps {
                echo '=== JMeter Load Test ==='

                script {
                    if (fileExists('ci-app/jmeter')) {
                        dir('ci-app') {
                            sh '''
                                set -e

                                echo "=== Recherche JMeter ==="

                                if command -v jmeter >/dev/null 2>&1; then
                                    jmeter --version

                                    mkdir -p target

                                    found=0

                                    for file in jmeter/*.jmx; do
                                        if [ -f "$file" ]; then
                                            found=1

                                            echo "=== Exécution de $file ==="

                                            jmeter \
                                              -n \
                                              -t "$file" \
                                              -l "target/jmeter-results.jtl"
                                        fi
                                    done

                                    if [ "$found" -eq 0 ]; then
                                        echo "Aucun fichier JMX trouvé."
                                    fi
                                else
                                    echo "JMeter non installé."
                                    echo "Étape ignorée."
                                fi
                            '''
                        }
                    } else {
                        echo 'Répertoire jmeter absent - étape ignorée.'
                    }
                }
            }
        }

        stage('Archive') {
            steps {
                echo '=== Archive des artefacts ==='

                archiveArtifacts(
                    artifacts: 'ci-app/target/*.war',
                    fingerprint: true,
                    allowEmptyArchive: false
                )

                archiveArtifacts(
                    artifacts: 'ci-app/target/site/jacoco/**',
                    fingerprint: true,
                    allowEmptyArchive: true
                )

                archiveArtifacts(
                    artifacts: 'ci-app/target/surefire-reports/**',
                    fingerprint: true,
                    allowEmptyArchive: true
                )

                archiveArtifacts(
                    artifacts: 'ci-app/target/jmeter-results.jtl',
                    fingerprint: true,
                    allowEmptyArchive: true
                )
            }
        }

        stage('Docker Build, Trivy Scan and Docker Hub Push') {
            agent {
                label 'docker-trivy'
            }

            steps {
                echo '=== Construction, scan Trivy et publication Docker Hub ==='
                deleteDir()
                unstash 'ci-app-war'

                sh '''
                    set -eu

                    test -f ci-app/target/ci-app-1.0-SNAPSHOT.war

                    cat > Dockerfile <<'EOF'
FROM tomcat:9.0-jdk21-temurin
RUN rm -rf /usr/local/tomcat/webapps/*
COPY ci-app/target/ci-app-1.0-SNAPSHOT.war /usr/local/tomcat/webapps/ci-app.war
EXPOSE 8080
CMD ["catalina.sh", "run"]
EOF
                '''

                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-credentials',
                        usernameVariable: 'DOCKERHUB_USER',
                        passwordVariable: 'DOCKERHUB_TOKEN'
                    )
                ]) {
                    sh '''
                        set -eu

                        IMAGE="$DOCKERHUB_USER/ci-app"
                        BUILD_TAG="$IMAGE:$BUILD_NUMBER"

                        echo "=== Construction de l'image : $BUILD_TAG ==="
                        docker build \\
                            --pull \\
                            -t "$BUILD_TAG" \\
                            -t "$IMAGE:latest" .

                        echo "=== Analyse Trivy : vulnérabilités HIGH et CRITICAL ==="
                        trivy image \\
                            --severity HIGH,CRITICAL \\
                            --ignore-unfixed \\
                            --exit-code 1 \\
                            "$BUILD_TAG"

                        echo "=== Connexion à Docker Hub ==="
                        echo "$DOCKERHUB_TOKEN" |
                            docker login --username "$DOCKERHUB_USER" --password-stdin

                        echo "=== Publication sur Docker Hub ==="
                        docker push "$BUILD_TAG"
                        docker push "$IMAGE:latest"

                        docker logout
                    '''
                }
            }

            post {
                always {
                    echo '=== Fin de l’étape Docker / Trivy ==='
                }
            }
        }
    }

    post {

        success {
            echo '=== CI SUCCESS ==='
        }

        failure {
            echo '=== CI FAILURE ==='
        }

        unstable {
            echo '=== CI UNSTABLE ==='
        }

        aborted {
            echo '=== CI ABORTED ==='
        }

        always {
            script {
                def finalStatus =
                    currentBuild.currentResult ?: 'UNKNOWN'

                def statusColor = '#666666'

                if (finalStatus == 'SUCCESS') {
                    statusColor = '#228B22'
                } else if (finalStatus == 'FAILURE') {
                    statusColor = '#CC0000'
                } else if (finalStatus == 'UNSTABLE') {
                    statusColor = '#E69500'
                } else if (finalStatus == 'ABORTED') {
                    statusColor = '#666666'
                }

                def emailSubject =
                    "[${finalStatus}] ${env.JOB_NAME} - Build #${env.BUILD_NUMBER}"

                def emailBody = """
<html>
<body style="font-family: Arial, sans-serif;">

    <h2 style="color: ${statusColor};">
        Notification Jenkins : ${finalStatus}
    </h2>

    <p>Bonjour,</p>

    <p>
        Le pipeline CI/CD Jenkins est terminé.
        Voici le récapitulatif de l'exécution.
    </p>

    <table border="1" cellpadding="8" cellspacing="0"
           style="border-collapse: collapse;">
        <tr>
            <td><b>Projet</b></td>
            <td>${env.JOB_NAME}</td>
        </tr>
        <tr>
            <td><b>Build</b></td>
            <td>#${env.BUILD_NUMBER}</td>
        </tr>
        <tr>
            <td><b>Statut</b></td>
            <td style="color: ${statusColor};">
                <b>${finalStatus}</b>
            </td>
        </tr>
        <tr>
            <td><b>Durée</b></td>
            <td>${currentBuild.durationString}</td>
        </tr>
    </table>

    <p>
        <a href="${env.BUILD_URL}">
            Consulter le build Jenkins
        </a>
    </p>

    <p>
        En cas d'échec, consultez :
        <a href="${env.BUILD_URL}console">
            Console Output
        </a>
    </p>

    <p>
        Cordialement,<br/>
        Jenkins CI/CD
    </p>

</body>
</html>
"""

                echo '=== NOTIFICATION FINALE ==='
                echo "Destinataire : ${env.EMAIL_TO}"
                echo "Statut final : ${finalStatus}"

                try {
                    emailext(
                        to: env.EMAIL_TO,
                        subject: emailSubject,
                        mimeType: 'text/html',
                        body: emailBody
                    )

                    echo '=== APPEL EMAILEXT TERMINE ==='

                } catch (Exception e) {
                    echo '=== ERREUR ENVOI EMAIL ==='
                    echo "Détail : ${e.getMessage()}"
                    echo 'Vérifier les logs Jenkins et Email Extension.'
                }
            }

            echo '=== Pipeline terminé ==='

            cleanWs(
                deleteDirs: true,
                disableDeferredWipeout: true,
                notFailBuild: true
            )
        }
    }
}
