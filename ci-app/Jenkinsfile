
pipeline {
    agent {
        label 'centos-build'
    }

    options {
        timestamps()
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
    }

    environment {
        // Java 17 pour compiler et executer les tests
        JAVA_HOME = '/opt/java/jdk-17.0.20.1+1'
        MAVEN_OPTS = '-Xmx1024m'

        // A ADAPTER aux chemins reels de l'agent centos-build
        SONAR_JAVA_HOME = '/opt/java/jdk-21'
        SONAR_MAVEN_HOME = '/opt/maven/apache-maven-3.9.11'

        GIT_URL = 'https://github.com/INSAF-DEBUG/CI-Lab.git'
        APP_DIR = 'ci-app'

        SONAR_PROJECT_KEY = 'com.insaf.cilab:ci-app'
        SONAR_PROJECT_NAME = 'ci-app'

        NEXUS_URL = 'http://192.168.42.128:8081'
        NEXUS_REPOSITORY = 'maven-snapshots'
        NEXUS_GROUP_PATH = 'com/insaf/cilab/ci-app/1.0-SNAPSHOT'

        DOCKER_IMAGE = 'insafnemri/ci-app'
        DOCKER_BASE_IMAGE = 'tomcat:9.0-jdk21-temurin-noble'
    }

    stages {

        stage('Checkout') {
            steps {
                echo '=== Checkout Git ==='

                checkout([
                    $class: 'GitSCM',
                    branches: [[name: '*/main']],
                    userRemoteConfigs: [[
                        url: "${GIT_URL}"
                    ]]
                ])
            }
        }

        stage('Check Java / Maven') {
            steps {
                echo '=== Verification Java 17 / Maven ==='

                sh '''
                    set -eu

                    test -x "$JAVA_HOME/bin/java"

                    export PATH="$JAVA_HOME/bin:$PATH"

                    echo "=== JAVA_HOME ==="
                    echo "$JAVA_HOME"

                    java -version

                    echo "=== Maven ==="
                    mvn -version

                    mvn -version | grep 'Java version: 17'
                '''
            }
        }

        stage('Build') {
            steps {
                echo '=== Construction Maven ==='

                dir("${APP_DIR}") {
                    sh '''
                        set -eu

                        test -f pom.xml

                        mvn clean package -DskipTests

                        test -s target/ci-app-1.0-SNAPSHOT.war

                        ls -lh target/ci-app-1.0-SNAPSHOT.war
                    '''
                }
            }
        }

        stage('Tests') {
            steps {
                echo '=== Tests unitaires, integration et Selenium ==='

                dir("${APP_DIR}") {
                    sh '''
                        set -eu

                        export PATH="$JAVA_HOME/bin:$PATH"
                        export MOZ_HEADLESS=1

                        mvn test

                        test -s target/jacoco.exec
                        test -s target/site/jacoco/jacoco.xml

                        echo "=== Rapport JaCoCo genere ==="
                        ls -lh target/site/jacoco/jacoco.xml
                    '''
                }
            }

            post {
                always {
                    junit(
                        testResults: 'ci-app/target/surefire-reports/*.xml',
                        allowEmptyResults: false
                    )
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                echo '=== Analyse SonarQube avec Java 21 ==='

                dir("${APP_DIR}") {
                    withEnv([
                        "JAVA_HOME=${SONAR_JAVA_HOME}",
                        "PATH+SONAR_JAVA=${SONAR_JAVA_HOME}/bin",
                        "PATH+SONAR_MAVEN=${SONAR_MAVEN_HOME}/bin"
                    ]) {
                        withSonarQubeEnv('SonarQube') {
                            sh '''
                                set -eu

                                test -x "$JAVA_HOME/bin/java"
                                test -x "$SONAR_MAVEN_HOME/bin/mvn"

                                echo "=== Java du scanner ==="
                                java -version

                                echo "=== Maven du scanner ==="
                                "$SONAR_MAVEN_HOME/bin/mvn" -version

                                echo "=== Rapport de couverture ==="
                                test -s target/site/jacoco/jacoco.xml

                                "$SONAR_MAVEN_HOME/bin/mvn" \
                                  org.sonarsource.scanner.maven:sonar-maven-plugin:5.2.0.4988:sonar \
                                  -Dsonar.projectKey="$SONAR_PROJECT_KEY" \
                                  -Dsonar.projectName="$SONAR_PROJECT_NAME" \
                                  -Dsonar.sources=src/main/java \
                                  -Dsonar.tests=src/test/java \
                                  -Dsonar.exclusions="**/target/**,**/*.js,**/*.ts,**/*.css,**/src/main/webapp/**" \
                                  -Dsonar.coverage.jacoco.xmlReportPaths=target/site/jacoco/jacoco.xml
                            '''
                        }
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                echo '=== Verification du Quality Gate ==='

                timeout(time: 10, unit: 'MINUTES') {
                    waitForQualityGate(
                        abortPipeline: true
                    )
                }
            }
        }

        stage('Deploy to Nexus') {
            steps {
                echo '=== Publication du WAR dans Nexus ==='

                dir("${APP_DIR}") {
                    sh '''
                        set -eu

                        test -s target/ci-app-1.0-SNAPSHOT.war

                        export PATH="$JAVA_HOME/bin:$PATH"

                        mvn deploy -DskipTests

                        echo "=== WAR publie dans Nexus ==="
                    '''
                }
            }
        }

        stage('JMeter Load Test') {
            steps {
                echo '=== Test de charge JMeter ==='

                script {
                    if (fileExists('jmeter/test-plan.jmx')) {
                        sh '''
                            set -eu

                            if [ -x ./jmeter/apache-jmeter/bin/jmeter ]; then
                                JMETER="./jmeter/apache-jmeter/bin/jmeter"
                            elif command -v jmeter >/dev/null 2>&1; then
                                JMETER="jmeter"
                            else
                                echo "JMeter absent : etape ignoree."
                                exit 0
                            fi

                            mkdir -p ci-app/target

                            "$JMETER" -n \
                              -t jmeter/test-plan.jmx \
                              -l ci-app/target/jmeter-results.jtl \
                              -j ci-app/target/jmeter.log

                            echo "=== Test de charge termine ==="
                        '''
                    } else {
                        echo 'Plan JMeter absent : etape ignoree.'
                    }
                }
            }
        }

        stage('Archive') {
            steps {
                echo '=== Archivage des artefacts ==='

                archiveArtifacts(
                    artifacts: 'ci-app/target/*.war',
                    allowEmptyArchive: false,
                    fingerprint: true
                )

                archiveArtifacts(
                    artifacts: 'ci-app/target/site/jacoco/**',
                    allowEmptyArchive: true,
                    fingerprint: true
                )

                archiveArtifacts(
                    artifacts: 'ci-app/target/surefire-reports/*.xml',
                    allowEmptyArchive: false,
                    fingerprint: true
                )

                archiveArtifacts(
                    artifacts: 'ci-app/target/jmeter-results.jtl,ci-app/target/jmeter.log',
                    allowEmptyArchive: true,
                    fingerprint: true
                )
            }
        }

        stage('Docker Build, Trivy Scan and Docker Hub Push') {
            agent {
                label 'docker-trivy'
            }

            steps {
                echo '=== Recuperation Nexus, Docker, Trivy et Docker Hub ==='

                deleteDir()

                withCredentials([
                    usernamePassword(
                        credentialsId: 'nexus-credentials',
                        usernameVariable: 'NEXUS_USER',
                        passwordVariable: 'NEXUS_PASSWORD'
                    )
                ]) {
                    sh '''
                        set -eu

                        mkdir -p ci-app/target

                        METADATA_URL="${NEXUS_URL}/repository/${NEXUS_REPOSITORY}/${NEXUS_GROUP_PATH}/maven-metadata.xml"

                        echo "=== Lecture des metadonnees Nexus ==="

                        curl --fail --silent --show-error \
                          --user "$NEXUS_USER:$NEXUS_PASSWORD" \
                          --output /tmp/maven-metadata.xml \
                          "$METADATA_URL"

                        SNAPSHOT_VERSION=$(python -c '
import xml.etree.ElementTree as ET

root = ET.parse("/tmp/maven-metadata.xml").getroot()
ns = {"m": root.tag.split("}")[0].strip("{")} if "}" in root.tag else {}

nodes = root.findall(".//m:snapshotVersion", ns) if ns else root.findall(".//snapshotVersion")

for node in nodes:
    get = lambda key: (
        node.findtext("m:" + key, default="", namespaces=ns)
        if ns else node.findtext(key, default="")
    )

    if get("extension") == "war" and not get("classifier"):
        value = get("value")
        if value:
            print(value)
            break
')

                        if [ -z "$SNAPSHOT_VERSION" ]; then
                            echo "ERREUR : aucun WAR snapshot trouve."
                            exit 1
                        fi

                        echo "Snapshot : $SNAPSHOT_VERSION"

                        WAR_URL="${NEXUS_URL}/repository/${NEXUS_REPOSITORY}/${NEXUS_GROUP_PATH}/ci-app-${SNAPSHOT_VERSION}.war"

                        curl --fail --silent --show-error \
                          --user "$NEXUS_USER:$NEXUS_PASSWORD" \
                          --output ci-app/target/ci-app-1.0-SNAPSHOT.war \
                          "$WAR_URL"

                        test -s ci-app/target/ci-app-1.0-SNAPSHOT.war

                        ls -lh ci-app/target/ci-app-1.0-SNAPSHOT.war
                    '''
                }

                sh '''
                    set -eu

                    cat > Dockerfile <<EOF
FROM ${DOCKER_BASE_IMAGE}

RUN rm -rf /usr/local/tomcat/webapps/*

COPY --chown=tomcat:tomcat ci-app/target/ci-app-1.0-SNAPSHOT.war /usr/local/tomcat/webapps/ci-app.war

EXPOSE 8080

USER tomcat

HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \\
    CMD bash -c 'cat < /dev/null > /dev/tcp/127.0.0.1/8080' || exit 1

CMD ["catalina.sh", "run"]
EOF

                    echo "=== Dockerfile genere ==="
                    cat Dockerfile
                '''

                withCredentials([
                    string(
                        credentialsId: 'DOCKERHUB_TOKEN',
                        variable: 'DOCKERHUB_TOKEN'
                    )
                ]) {
                    sh '''
                        set -eu

                        IMAGE="$DOCKER_IMAGE"
                        BUILD_TAG="${IMAGE}:${BUILD_NUMBER}"

                        echo "=== Construction Docker ==="

                        docker build --pull \
                          -t "$BUILD_TAG" \
                          -t "${IMAGE}:latest" \
                          .

                        echo "=== Scan Trivy HIGH / CRITICAL ==="

                        trivy image \
                          --timeout 15m \
                          --severity HIGH,CRITICAL \
                          --ignore-unfixed \
                          --exit-code 1 \
                          "$BUILD_TAG"

                        echo "=== Scan Trivy reussi ==="

                        echo "=== Connexion Docker Hub ==="

                        printf '%s' "$DOCKERHUB_TOKEN" |
                          docker login \
                            --username "Insafnemri" \
                            --password-stdin

                        echo "=== Publication Docker Hub ==="

                        docker push "$BUILD_TAG"
                        docker push "${IMAGE}:latest"

                        echo "=== Images publiees ==="
                        echo "$BUILD_TAG"
                        echo "${IMAGE}:latest"

                        docker logout
                    '''
                }
            }

            post {
                always {
                    echo '=== Fin de l'etape Docker / Trivy ==='
                }
            }
        }
    }

    post {
        success {
            echo '=== CI/CD SUCCESS : Pipeline termine ==='
        }

        failure {
            echo '=== CI/CD FAILURE : Consulter les logs Jenkins ==='
        }

        always {
            cleanWs()
        }
    }
}
