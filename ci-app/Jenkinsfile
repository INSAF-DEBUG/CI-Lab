pipeline {
    agent none

    options {
        timestamps()
        timeout(time: 60, unit: 'MINUTES')
        disableConcurrentBuilds()
    }

    environment {
        NEXUS_URL = 'http://192.168.42.128:8081'
        NEXUS_REPO = 'maven-snapshots'
        NEXUS_GROUP_PATH = 'com/insaf/cilab/ci-app/1.0-SNAPSHOT'

        DOCKER_IMAGE = 'ci-app'
        SWARM_SERVICE = 'ci-app'
        SWARM_PORT = '8080'
        SWARM_REPLICAS = '2'
    }

    stages {

        stage('1 - Checkout Git') {
            agent { label 'centos-build' }

            steps {
                checkout scm

                sh '''
                    set -eu
                    test -f ci-app/pom.xml
                    echo "Repository recupere"
                    git log -1 --oneline
                '''
            }
        }

        stage('2 - Verification Java et Maven') {
            agent { label 'centos-build' }

            steps {
                sh '''
                    set -eu
                    java -version
                    mvn -version
                    command -v git
                '''
            }
        }

        stage('3 - Build Maven') {
            agent { label 'centos-build' }

            steps {
                dir('ci-app') {
                    sh '''
                        set -eu
                        mvn -B clean package -DskipTests
                        test -s target/ci-app-1.0-SNAPSHOT.war
                    '''
                }

                archiveArtifacts(
                    artifacts: 'ci-app/target/*.war',
                    fingerprint: true
                )
            }
        }

        stage('4 - Tests et couverture JaCoCo') {
            agent { label 'centos-build' }

            steps {
                dir('ci-app') {
                    sh '''
                        set -eu
                        export MOZ_HEADLESS=1

                        mvn -B \
                          org.jacoco:jacoco-maven-plugin:0.8.12:prepare-agent \
                          test \
                          org.jacoco:jacoco-maven-plugin:0.8.12:report

                        test -f target/site/jacoco/index.html
                        test -f target/site/jacoco/jacoco.xml
                    '''
                }
            }

            post {
                always {
                    junit(
                        testResults: 'ci-app/target/surefire-reports/*.xml',
                        allowEmptyResults: false
                    )

                    archiveArtifacts(
                        artifacts: 'ci-app/target/site/jacoco/**',
                        allowEmptyArchive: true
                    )
                }
            }
        }

        stage('5 - Publication Maven vers Nexus') {
            agent { label 'centos-build' }

            steps {
                dir('ci-app') {
                    withCredentials([
                        usernamePassword(
                            credentialsId: 'nexus-credentials',
                            usernameVariable: 'NEXUS_USER',
                            passwordVariable: 'NEXUS_PASSWORD'
                        )
                    ]) {
                        sh '''
                            set -eu

                            curl -fsS \
                              --connect-timeout 10 \
                              -u "$NEXUS_USER:$NEXUS_PASSWORD" \
                              "$NEXUS_URL/" \
                              -o /dev/null

                            mvn -B deploy -DskipTests
                        '''
                    }
                }
            }
        }

        stage('6 - Telechargement WAR depuis Nexus') {
            agent { label 'docker-trivy' }

            steps {
                deleteDir()
                checkout scm

                withCredentials([
                    usernamePassword(
                        credentialsId: 'nexus-credentials',
                        usernameVariable: 'NEXUS_USER',
                        passwordVariable: 'NEXUS_PASSWORD'
                    )
                ]) {
                    sh '''
                        set -eu

                        command -v curl
                        command -v docker
                        command -v trivy

                        BASE_URL="$NEXUS_URL/repository/$NEXUS_REPO/$NEXUS_GROUP_PATH"

                        mkdir -p deploy

                        echo "Lecture des metadonnees Nexus"

                        curl -fsSL \
                          --retry 3 \
                          --connect-timeout 10 \
                          -u "$NEXUS_USER:$NEXUS_PASSWORD" \
                          "$BASE_URL/maven-metadata.xml" \
                          -o deploy/maven-metadata.xml

                        echo "Recherche de la version WAR"

                        VERSION=$(python -c '
import xml.etree.ElementTree as ET
import sys

root = ET.parse(sys.argv[1]).getroot()

for item in root.iter("snapshotVersion"):
    extension = item.findtext("extension")
    classifier = item.findtext("classifier")
    value = item.findtext("value")

    if extension == "war" and not classifier and value:
        print(value)
        break
' deploy/maven-metadata.xml)

                        if [ -z "$VERSION" ]; then
                            echo "ERREUR : version WAR introuvable"
                            cat deploy/maven-metadata.xml
                            exit 1
                        fi

                        echo "Version WAR : $VERSION"

                        curl -fSL \
                          --retry 3 \
                          --connect-timeout 10 \
                          -u "$NEXUS_USER:$NEXUS_PASSWORD" \
                          "$BASE_URL/ci-app-$VERSION.war" \
                          -o deploy/ci-app.war

                        test -s deploy/ci-app.war
                        test -f Dockerfile

                        echo "WAR telecharge avec succes"
                        ls -lh deploy/ci-app.war
                    '''
                }
            }
        }

        stage('7 - Build image Docker') {
            agent { label 'docker-trivy' }

            steps {
                script {
                    env.FULL_IMAGE =
                        "${env.DOCKERHUB_USER ?: 'DOCKERHUB_USERNAME'}/${env.DOCKER_IMAGE}:${env.BUILD_NUMBER}"
                }

                sh '''
                    set -eu

                    docker build \
                      --pull \
                      -t "$FULL_IMAGE" \
                      .
                '''
            }
        }

        stage('8 - Scan securite Trivy') {
            agent { label 'docker-trivy' }

            steps {
                sh '''
                    set -eu

                    trivy image \
                      --severity HIGH,CRITICAL \
                      --exit-code 1 \
                      "$FULL_IMAGE"
                '''
            }
        }

        stage('9 - Push Docker Hub') {
            agent { label 'docker-trivy' }

            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-credentials',
                        usernameVariable: 'DOCKERHUB_USER',
                        passwordVariable: 'DOCKERHUB_PASSWORD'
                    )
                ]) {
                    sh '''
                        set -eu

                        IMAGE="$DOCKERHUB_USER/ci-app:$BUILD_NUMBER"

                        docker tag "$FULL_IMAGE" "$IMAGE"

                        echo "$DOCKERHUB_PASSWORD" |
                          docker login \
                            --username "$DOCKERHUB_USER" \
                            --password-stdin

                        docker push "$IMAGE"

                        docker logout
                    '''
                }
            }
        }

        stage('10 - Deploiement Docker Swarm') {
            agent { label 'docker-trivy' }

            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-credentials',
                        usernameVariable: 'DOCKERHUB_USER',
                        passwordVariable: 'DOCKERHUB_PASSWORD'
                    )
                ]) {
                    sh '''
                        set -eu

                        IMAGE="$DOCKERHUB_USER/ci-app:$BUILD_NUMBER"

                        STATE=$(docker info \
                          --format '{{.Swarm.LocalNodeState}}')

                        if [ "$STATE" != "active" ]; then
                            echo "ERREUR : aucun Swarm actif sur ce noeud"
                            exit 1
                        fi

                        echo "$DOCKERHUB_PASSWORD" |
                          docker login \
                            --username "$DOCKERHUB_USER" \
                            --password-stdin

                        if docker service inspect "$SWARM_SERVICE" \
                          >/dev/null 2>&1; then

                            docker service update \
                              --image "$IMAGE" \
                              --with-registry-auth \
                              "$SWARM_SERVICE"
                        else
                            docker service create \
                              --name "$SWARM_SERVICE" \
                              --publish "$SWARM_PORT:8080" \
                              --replicas "$SWARM_REPLICAS" \
                              --with-registry-auth \
                              "$IMAGE"
                        fi

                        docker logout

                        echo "Verification du service Swarm"

                        docker service ps "$SWARM_SERVICE"

                        docker service inspect \
                          --format '{{.Spec.Name}} - {{.UpdateStatus.State}}' \
                          "$SWARM_SERVICE"
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'Pipeline termine avec succes.'
        }

        failure {
            echo 'Pipeline en echec. Consulter la Console Output.'
        }

        always {
            echo 'Fin du pipeline.'
        }
    }
}
