
pipeline {
    agent none

    options {
        timestamps()
        timeout(time: 60, unit: 'MINUTES')
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
    }

    environment {
        GIT_URL          = 'https://github.com/INSAF-DEBUG/CI-Lab.git'
        GIT_BRANCH       = 'main'

        NEXUS_URL        = 'http://192.168.42.128:8081'
        NEXUS_REPO       = 'maven-snapshots'
        NEXUS_GROUP      = 'com.insaf.cilab'
        GROUP_PATH       = 'com/insaf/cilab/ci-app'
        WAR_FILE         = 'ci-app-1.0-SNAPSHOT.war'

        DOCKER_IMAGE     = 'insafnemri/ci-app'
        DOCKER_TAG       = "${BUILD_NUMBER}"

        TRIVY_CACHE_DIR  = '/home/docker/.cache/trivy'

        // Service Swarm existant dans ton environnement
        SWARM_SERVICE    = 'ci-app'
    }

    stages {
             // ============================================================
        // STAGE 1 : RECUPERATION DU CODE SOURCE
        // ============================================================
        // ============================================================
        // STAGE 1 : RECUPERATION DU CODE SOURCE
        // ============================================================
        // ============================================================
        // STAGE 1 : RECUPERATION DU CODE SOURCE
        // ============================================================
        stage('1 - Recuperation du code source') {
            agent {
                label 'centos-build'
            }

            steps {
                deleteDir()

                sh '''
                    set -eu

                    echo "=== Environnement Git ==="
                    whoami
                    git --version

                    echo "=== Initialisation du depot ==="
                    git init
                    git remote add origin "$GIT_URL"

                    echo "=== Recuperation de la branche ==="
                    git fetch origin "$GIT_BRANCH"
                    git checkout -B "$GIT_BRANCH" FETCH_HEAD

                    echo "=== Verification du code ==="
                    git log -1 --oneline
                    test -f ci-app/pom.xml
                    test -f ci-app/Jenkinsfile

                    echo "Code source recupere avec succes."
                '''

                stash(
                    name: 'source-code',
                    includes: 'ci-app/**',
                    excludes: 'ci-app/.git/**'
                )
            }
        }

        // ============================================================
        // STAGE 2 : VERIFICATION JAVA ET MAVEN
        // ============================================================
         // ============================================================
        // STAGE 2 : VERIFICATION JAVA ET MAVEN
        // ============================================================
         // ============================================================
        // STAGE 2 : VERIFICATION JAVA ET MAVEN
        // ============================================================
        stage('2 - Verification Java et Maven') {
            agent {
                label 'centos-build'
            }

            steps {
                unstash 'source-code'

                dir('ci-app') {
                    sh '''
                        set -eu

                        echo "=== Utilisateur ==="
                        whoami

                        echo "=== Version Java ==="
                        java -version

                        echo "=== Version Maven ==="
                        mvn -version

                        echo "=== Verification du projet ==="
                        test -f pom.xml

                        echo "Environnement de build valide."
                    '''
                }
            }
        }

        // ============================================================
        // STAGE 3 : CONSTRUCTION MAVEN
        // ============================================================
         // ============================================================
        // STAGE 3 : CONSTRUCTION MAVEN
        // ============================================================
         // ============================================================
        // STAGE 3 : CONSTRUCTION MAVEN
        // ============================================================
        stage('3 - Construction Maven') {
            agent {
                label 'centos-build'
            }

            steps {
                unstash 'source-code'

                dir('ci-app') {
                    sh '''
                        set -eu

                        echo "=== Construction de l'application ==="

                        mvn -B clean package -DskipTests

                        echo "=== Verification du WAR ==="
                        test -s "target/$WAR_FILE"

                        ls -lh "target/$WAR_FILE"

                        echo "Construction Maven terminee."
                    '''
                }

                archiveArtifacts(
                    artifacts: 'ci-app/target/ci-app-1.0-SNAPSHOT.war',
                    fingerprint: true
                )

                stash(
                    name: 'built-war',
                    includes: 'ci-app/target/ci-app-1.0-SNAPSHOT.war'
                )
            }
        }

       
         // ============================================================
        // STAGE 4 : TESTS ET COUVERTURE JACOCO
        // ============================================================
         // ============================================================
        // STAGE 4 : TESTS ET COUVERTURE JACOCO
        // ============================================================
         // ============================================================
        // STAGE 4 : TESTS ET COUVERTURE JACOCO
        // ============================================================
         // ============================================================
        // STAGE 4 : TESTS ET COUVERTURE JACOCO
        // ============================================================
        stage('4 - Tests et couverture JaCoCo') {
            agent {
                label 'centos-build'
            }

            steps {
                unstash 'source-code'

                dir('ci-app') {
                    sh '''
                        set -eu

                        echo "=== Execution des tests ==="

                        export MOZ_HEADLESS=1

                        mvn -B clean \
                            org.jacoco:jacoco-maven-plugin:0.8.12:prepare-agent \
                            test \
                            org.jacoco:jacoco-maven-plugin:0.8.12:report

                        echo "=== Verification des rapports ==="

                        if [ -d target/surefire-reports ]; then
                            find target/surefire-reports \
                                -maxdepth 1 -type f -print
                        fi

                        if [ -f target/site/jacoco/index.html ]; then
                            echo "Rapport JaCoCo genere."
                        else
                            echo "Attention : rapport JaCoCo absent."
                        fi
                    '''

                    junit(
                        testResults: 'target/surefire-reports/*.xml',
                        allowEmptyResults: false
                    )

                    archiveArtifacts(
                        artifacts: 'target/site/jacoco/**',
                        allowEmptyArchive: true
                    )
                }
            }
        }

        // ============================================================
        // STAGE 5 : PUBLICATION DU WAR DANS NEXUS
        // ============================================================
         // ============================================================
        // STAGE 5 : PUBLICATION DU WAR DANS NEXUS
        // ============================================================
         // ============================================================
        // STAGE 5 : PUBLICATION DU WAR DANS NEXUS
        // ============================================================
         // ============================================================
        // STAGE 5 : PUBLICATION DU WAR DANS NEXUS
        // ============================================================ // ============================================================
        // STAGE 5 : PUBLICATION DU WAR DANS NEXUS
        // ============================================================
        
        stage('5 - Publication du WAR dans Nexus') {
            agent {
                label 'centos-build'
            }

            steps {
                unstash 'built-war'

                withCredentials([
                    usernamePassword(
                        credentialsId: 'nexus-credentials',
                        usernameVariable: 'NEXUS_USER',
                        passwordVariable: 'NEXUS_PASSWORD'
                    )
                ]) {
                    sh '''
                        set -eu

                        echo "=== Verification du WAR ==="
                        test -s "ci-app/target/$WAR_FILE"
                        ls -lh "ci-app/target/$WAR_FILE"

                        echo "=== Preparation des identifiants Maven ==="

                        mkdir -p "$HOME/.m2"

                        cat > "$HOME/.m2/settings.xml" <<EOF
<settings>
  <servers>
    <server>
      <id>nexus-snapshots</id>
      <username>${NEXUS_USER}</username>
      <password>${NEXUS_PASSWORD}</password>
    </server>
  </servers>
</settings>
EOF

                        chmod 600 "$HOME/.m2/settings.xml"

                        echo "=== Publication dans Nexus ==="

                        mvn -B \
                            org.apache.maven.plugins:maven-deploy-plugin:2.8.2:deploy-file \
                            -Dfile="ci-app/target/$WAR_FILE" \
                            -DgroupId="$NEXUS_GROUP" \
                            -DartifactId=ci-app \
                            -Dversion=1.0-SNAPSHOT \
                            -Dpackaging=war \
                            -DgeneratePom=true \
                            -DrepositoryId=nexus-snapshots \
                            -Durl="$NEXUS_URL/repository/$NEXUS_REPO/"

                        echo "Publication Nexus terminee."
                    '''
                }
            }
        }

        // ============================================================
        // STAGE 6 : TELECHARGEMENT AUTHENTIFIE DU WAR DEPUIS NEXUS
        // ============================================================
        // ============================================================
        // STAGE 6 : TELECHARGEMENT AUTHENTIFIE DU WAR DEPUIS NEXUS
        // ============================================================
        // ============================================================
        // STAGE 6 : TELECHARGEMENT AUTHENTIFIE DU WAR DEPUIS NEXUS
        // ============================================================
        // ============================================================
        // STAGE 6 : TELECHARGEMENT AUTHENTIFIE DU WAR DEPUIS NEXUS
        // ============================================================// ============================================================
        // STAGE 6 : TELECHARGEMENT AUTHENTIFIE DU WAR DEPUIS NEXUS
        // ============================================================
        
        stage('6 - Recuperation du WAR depuis Nexus') {
            agent {
                label 'centos-build'
            }

            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'nexus-credentials',
                        usernameVariable: 'NEXUS_USER',
                        passwordVariable: 'NEXUS_PASSWORD'
                    )
                ]) {
                    sh '''
                        set -eu

                        mkdir -p docker-context

                        METADATA_URL="$NEXUS_URL/repository/$NEXUS_REPO/$GROUP_PATH/1.0-SNAPSHOT/maven-metadata.xml"

                        echo "=== Recuperation des metadonnees Nexus ==="

                        curl --fail --silent --show-error \
                            --retry 3 \
                            --retry-delay 2 \
                            --user "$NEXUS_USER:$NEXUS_PASSWORD" \
                            "$METADATA_URL" \
                            -o docker-context/maven-metadata.xml

                        test -s docker-context/maven-metadata.xml

                        echo "=== Identification de la version du WAR ==="

                        SNAPSHOT_VERSION=$(python -c '
import xml.etree.ElementTree as ET

root = ET.parse("docker-context/maven-metadata.xml").getroot()

def child_text(element, name):
    for child in element:
        if child.tag.split("}")[-1] == name:
            return child.text
    return None

for item in root.iter():
    if item.tag.split("}")[-1] != "snapshotVersion":
        continue

    extension = child_text(item, "extension")
    classifier = child_text(item, "classifier")
    value = child_text(item, "value")

    if extension == "war" and not classifier and value:
        print(value)
        break
')

                        if [ -z "$SNAPSHOT_VERSION" ]; then
                            echo "ERREUR : version du WAR introuvable dans Nexus."
                            exit 1
                        fi

                        echo "Version Nexus trouvee : $SNAPSHOT_VERSION"

                        WAR_URL="$NEXUS_URL/repository/$NEXUS_REPO/$GROUP_PATH/1.0-SNAPSHOT/ci-app-$SNAPSHOT_VERSION.war"

                        echo "=== Telechargement authentifie du WAR ==="

                        curl --fail --silent --show-error \
                            --retry 3 \
                            --retry-delay 2 \
                            --user "$NEXUS_USER:$NEXUS_PASSWORD" \
                            "$WAR_URL" \
                            -o "docker-context/$WAR_FILE"

                        test -s "docker-context/$WAR_FILE"

                        echo "=== Verification du WAR ==="
                        ls -lh "docker-context/$WAR_FILE"

                        echo "WAR recupere depuis Nexus avec succes."
                    '''
                }

                stash(
                    name: 'nexus-war',
                    includes: 'docker-context/**'
                )
            }
        }

        // ============================================================
        // STAGE 7 : CONSTRUCTION DE L'IMAGE DOCKER
        // ============================================================
        // ============================================================
        // STAGE 7 : CONSTRUCTION DE L'IMAGE DOCKER
        // ============================================================
        // ============================================================
        // STAGE 7 : CONSTRUCTION DE L'IMAGE DOCKER
        // ============================================================
        // ============================================================
        // STAGE 7 : CONSTRUCTION DE L'IMAGE DOCKER
        // ============================================================
        stage('7 - Construction de l image Docker') {
            agent {
                label 'docker-trivy'
            }

            steps {
                deleteDir()
                unstash 'nexus-war'

                dir('docker-context') {
                    sh '''
                        set -eu

                        echo "=== Utilisateur Docker ==="
                        whoami
                        id

                        echo "=== Verification du WAR provenant de Nexus ==="
                        test -s "$WAR_FILE"
                        ls -lh "$WAR_FILE"

                        echo "=== Generation du Dockerfile ==="

                   cat > Dockerfile <<'EOF'
FROM tomcat:9.0-jdk8-temurin

USER root

RUN apt-get update \
    && apt-get install -y --no-install-recommends --only-upgrade curl libcurl4t64 \
    && rm -rf /var/lib/apt/lists/*

RUN rm -rf /usr/local/tomcat/webapps/*

COPY ci-app-1.0-SNAPSHOT.war /usr/local/tomcat/webapps/ROOT.war

EXPOSE 8080

CMD ["catalina.sh", "run"]
EOF

                       echo "=== Construction de l'image ==="

docker build --no-cache \
    -t insafnemri/ci-app:${BUILD_NUMBER} \
    -t insafnemri/ci-app:latest \
    .

echo "=== Verification de l'image ==="

docker image inspect "insafnemri/ci-app:${BUILD_NUMBER}" \
    --format 'Image={{.Id}}'

docker images insafnemri/ci-app

echo "Image Docker construite."
                    '''
                }
            }
        }

        // ============================================================
        // STAGE 8 : ANALYSE DE SECURITE TRIVY
        // ============================================================
         // ============================================================
        // STAGE 8 : ANALYSE DE SECURITE TRIVY
        // ============================================================
         // ============================================================
        // STAGE 8 : ANALYSE DE SECURITE TRIVY
        // ============================================================
         // ============================================================
        // STAGE 8 : ANALYSE DE SECURITE TRIVY
        // ============================================================
         // ============================================================
        // STAGE 8 : ANALYSE DE SECURITE TRIVY
        // ============================================================ // ============================================================
        // STAGE 8 : ANALYSE DE SECURITE TRIVY
        // ============================================================
        stage('8 - Analyse de securite Trivy') {
            agent {
                label 'docker-trivy'
            }

            steps {
                sh '''
                    set -eu

                    echo "=== Environnement Jenkins ==="
                    whoami
                    id
                    echo "HOME=$HOME"

                    echo "=== Verification Trivy ==="
                    command -v trivy
                    trivy --version

                    echo "=== Verification du cache Trivy ==="
                    echo "TRIVY_CACHE_DIR=$TRIVY_CACHE_DIR"

                    test -d "$TRIVY_CACHE_DIR/db" || {
                        echo "ERREUR : repertoire de base Trivy absent."
                        exit 1
                    }

                    test -s "$TRIVY_CACHE_DIR/db/trivy.db" || {
                        echo "ERREUR : trivy.db absent ou vide."
                        ls -lah "$TRIVY_CACHE_DIR/db"
                        exit 1
                    }

                    test -s "$TRIVY_CACHE_DIR/db/metadata.json" || {
                        echo "ERREUR : metadata.json absent ou vide."
                        ls -lah "$TRIVY_CACHE_DIR/db"
                        exit 1
                    }

                    echo "=== Base Trivy disponible ==="
                    ls -lh "$TRIVY_CACHE_DIR/db/"

                    echo "=== Verification de l'image a analyser ==="

                    docker image inspect "$DOCKER_IMAGE:$DOCKER_TAG" \
                        --format 'Image={{.Id}}'

                    echo "=== Preparation des exceptions existantes ==="

                    cat > .trivyignore <<'EOF'
CVE-2026-78667
CVE-2026-78669
CVE-2026-97031
EOF

                    echo "=== Analyse des vulnerabilites ==="

                    trivy \
                        --cache-dir "$TRIVY_CACHE_DIR" \
                        --timeout 30m \
                        image \
                        --skip-db-update \
                        --skip-java-db-update \
                        --scanners vuln \
                        --ignorefile .trivyignore \
                        --exit-code 1 \
                        --severity CRITICAL,HIGH \
                        "$DOCKER_IMAGE:$DOCKER_TAG"

                    echo "Scan Trivy termine : aucune vulnerabilite HIGH/CRITICAL bloquante detectee."
                '''
            }
        }

       
        // ============================================================
        // STAGE 9 : PUBLICATION SUR DOCKER HUB
        // ============================================================
         // ============================================================
        // STAGE 9 : PUBLICATION SUR DOCKER HUB
        // ============================================================
         // ============================================================
        // STAGE 9 : PUBLICATION SUR DOCKER HUB
        // ============================================================
         // ============================================================
        // STAGE 9 : PUBLICATION SUR DOCKER HUB
        // ============================================================
         // ============================================================
        // STAGE 9 : PUBLICATION SUR DOCKER HUB
        // ============================================================
         // ============================================================
        // STAGE 9 : PUBLICATION SUR DOCKER HUB
        // ============================================================
       
        // ============================================================
        // STAGE 9 : PUBLICATION SUR DOCKER HUB
        // ============================================================
        stage('9 - Publication sur Docker Hub') {
            agent {
                label 'docker-trivy'
            }

            steps {
                withCredentials([
                    string(
                        credentialsId: 'DOCKERHUB_TOKEN',
                        variable: 'DOCKERHUB_PASSWORD'
                    )
                ]) {
                    sh '''
                        set -eu
                        set +x

                        echo "=== Verification des images ==="
                        docker image inspect "${DOCKER_IMAGE}:${DOCKER_TAG}" >/dev/null
                        docker image inspect "${DOCKER_IMAGE}:latest" >/dev/null

                        echo "=== Connexion a Docker Hub ==="
                        printf '%s' "$DOCKERHUB_PASSWORD" |
                            docker login \
                                --username "insafnemri" \
                                --password-stdin

                        echo "=== Publication de l'image versionnee ==="
                        docker push "${DOCKER_IMAGE}:${DOCKER_TAG}"

                        echo "=== Publication de latest ==="
                        docker push "${DOCKER_IMAGE}:latest"

                        echo "=== Deconnexion ==="
                        docker logout

                        echo "Publication Docker Hub terminee."
                    '''
                }
            }
        }

        // ============================================================
        // STAGE 10 : DEPLOIEMENT DOCKER SWARM
        // ============================================================
        // ============================================================
        // STAGE 10 : DEPLOIEMENT DOCKER SWARM
        // ============================================================
        // ============================================================
        // STAGE 10 : DEPLOIEMENT DOCKER SWARM
        // ============================================================
        // ============================================================
        // STAGE 10 : DEPLOIEMENT DOCKER SWARM
        // ============================================================
        // ============================================================
        // STAGE 10 : DEPLOIEMENT DOCKER SWARM
        // ============================================================
       
        // ============================================================
        // STAGE 10 : DEPLOIEMENT DOCKER SWARM
        // ============================================================
        stage('10 - Deploiement Docker Swarm') {
            agent {
                label 'docker-swarm'
            }

            steps {
                withCredentials([
                    string(
                        credentialsId: 'DOCKERHUB_TOKEN',
                        variable: 'DOCKERHUB_PASSWORD'
                    )
                ]) {
                    sh '''
                        set -eu
                        set +x

                        echo "=== Verification de Docker Swarm ==="

                        SWARM_STATE=$(docker info --format '{{.Swarm.LocalNodeState}}')
                        echo "Etat Swarm : $SWARM_STATE"

                        if [ "$SWARM_STATE" != "active" ]; then
                            echo "ERREUR : Docker Swarm n'est pas actif sur ce noeud."
                            exit 1
                        fi

                        echo "=== Connexion a Docker Hub ==="

                        printf '%s' "$DOCKERHUB_PASSWORD" |
                            docker login \
                                --username "insafnemri" \
                                --password-stdin

                        echo "=== Recuperation de l'image publiee ==="

                        docker pull "${DOCKER_IMAGE}:${DOCKER_TAG}"

                        echo "=== Verification du service ==="

                        if docker service inspect "$SWARM_SERVICE" >/dev/null 2>&1; then
                            echo "Le service $SWARM_SERVICE existe deja."

                            docker service update \
                                --image "${DOCKER_IMAGE}:${DOCKER_TAG}" \
                                --with-registry-auth \
                                "$SWARM_SERVICE"
                        else
                            echo "Creation du service $SWARM_SERVICE."

                            docker service create \
                                --name "$SWARM_SERVICE" \
                                --publish published=8080,target=8080 \
                                --replicas 2 \
                                --with-registry-auth \
                                "$DOCKER_IMAGE:${DOCKER_TAG}"
                        fi

                        echo "=== Verification du deploiement ==="

                        docker service ls
                        docker service ps "$SWARM_SERVICE"

                        docker logout

                        echo "Deploiement Swarm termine."
                    '''
                }
            }
        }


    // ================================================================
    // POST : RESULTAT DU PIPELINE
    // ================================================================

      // ================================================================
    // POST : RESULTAT DU PIPELINE
    // ================================================================
      // ================================================================
    // POST : RESULTAT DU PIPELINE
    // ================================================================
      // ================================================================
    // POST : RESULTAT DU PIPELINE
    // ================================================================
      // ================================================================
    // POST : RESULTAT DU PIPELINE
    // ================================================================
  
    } // Fin du bloc stages

    post {
        success {
            echo 'Pipeline CI/CD termine avec succes.'
            echo "Image publiee : ${DOCKER_IMAGE}:${DOCKER_TAG}"
            echo "Service Swarm : ${SWARM_SERVICE}"
        }

        failure {
            echo 'ERREUR : le pipeline CI/CD a echoue.'
            echo 'Consultez la console Jenkins pour identifier le stage en erreur.'
        }

        always {
            echo "Fin du build #${BUILD_NUMBER}."
        }
    }
} // Fin du bloc pipeline
