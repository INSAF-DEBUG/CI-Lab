
pipeline {
    agent {
        label 'centos-build'
    }

    options {
        timestamps()
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
    }

    environment {
        // Java 17 : correction de PATH+JDK17
        JAVA_HOME = '/opt/java/jdk-17.0.20.1+1'
        PATH = "/opt/java/jdk-17.0.20.1+1/bin:${env.PATH}"

        GIT_URL = 'https://github.com/INSAF-DEBUG/CI-Lab.git'
        APP_DIR = 'ci-app'

        MAVEN_OPTS = '-Xmx1024m'

        SONAR_PROJECT_KEY = 'com.insaf.cilab:ci-app'
        SONAR_PROJECT_NAME = 'ci-app'

        NEXUS_URL = 'http://192.168.42.128:8081'
        NEXUS_REPOSITORY = 'maven-snapshots'
        NEXUS_GROUP_PATH = 'com/insaf/cilab/ci-app/1.0-SNAPSHOT'
        WAR_NAME = 'ci-app-1.0-SNAPSHOT.war'

        DOCKER_IMAGE = 'insafnemri/ci-app'
        DOCKER_BASE_IMAGE = 'tomcat:9.0-jdk21-temurin-noble'
    }

    stages {

        stage('Checkout') {
            steps {
                echo '=== Checkout Git ==='

                checkout([
                    $class: 'GitSCM',
                    branches: [[name: '*/main']],
                    userRemoteConfigs: [[
                        url: "${GIT_URL}"
                    ]]
                ])
            }
        }

        stage('Check Java / Maven') {
            steps {
                echo '=== Verification Java 17 / Maven ==='

                sh '''
                    set -eu

                    echo "=== JAVA_HOME ==="
                    echo "$JAVA_HOME"

                    test -x "$JAVA_HOME/bin/java"

                    echo "=== Java ==="
                    "$JAVA_HOME/bin/java" -version

                    echo "=== Maven ==="
                    mvn -version

                    mvn -version | grep 'Java version: 17'
                '''
            }
        }

        stage('Build') {
            steps {
                echo '=== Build Maven ==='

                dir("${APP_DIR}") {
                    sh '''
                        set -eu

                        test -f pom.xml

                        mvn clean package -DskipTests

                        test -s target/ci-app-1.0-SNAPSHOT.war

                        ls -lh target/ci-app-1.0-SNAPSHOT.war
                    '''
                }
            }
        }

        stage('Tests') {
            steps {
                echo '=== Tests Maven ==='

                dir("${APP_DIR}") {
                    sh '''
                        set -eu

                        export MOZ_HEADLESS=1

                        mvn test
                    '''
                }
            }

            post {
                always {
                    junit(
                        testResults: 'ci-app/target/surefire-reports/*.xml',
                        allowEmptyResults: false
                    )
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                echo '=== Analyse SonarQube ==='

                dir("${APP_DIR}") {
                    withSonarQubeEnv('SonarQube') {
                        sh '''
                            set -eu

                            mvn sonar:sonar \
                              -Dsonar.projectKey="${SONAR_PROJECT_KEY}" \
                              -Dsonar.projectName="${SONAR_PROJECT_NAME}" \
                              -Dsonar.sources=src/main/java \
                              -Dsonar.tests=src/test/java \
                              -Dsonar.exclusions="**/target/**,**/*.js,**/*.ts,**/*.css,**/src/main/webapp/**" \
                              -Dsonar.coverage.jacoco.xmlReportPaths=target/site/jacoco/jacoco.xml
                        '''
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                echo '=== Quality Gate SonarQube ==='

                timeout(time: 10, unit: 'MINUTES') {
                    waitForQualityGate(
                        abortPipeline: true
                    )
                }
            }
        }

        stage('Deploy to Nexus') {
            steps {
                echo '=== Publication du WAR dans Nexus ==='

                dir("${APP_DIR}") {
                    sh '''
                        set -eu

                        test -s target/ci-app-1.0-SNAPSHOT.war

                        mvn deploy -DskipTests

                        echo "=== WAR publie dans Nexus ==="
                    '''
                }
            }
        }

        stage('JMeter Load Test') {
            steps {
                echo '=== JMeter Load Test ==='

                script {
                    if (fileExists('jmeter')) {
                        sh '''
                            set -eu

                            if [ -x ./jmeter/apache-jmeter/bin/jmeter ]; then
                                JMETER="./jmeter/apache-jmeter/bin/jmeter"
                            elif command -v jmeter >/dev/null 2>&1; then
                                JMETER="jmeter"
                            else
                                echo "JMeter non installe : etape ignoree."
                                exit 0
                            fi

                            if [ -f jmeter/test-plan.jmx ]; then
                                mkdir -p ci-app/target

                                "$JMETER" -n \
                                  -t jmeter/test-plan.jmx \
                                  -l ci-app/target/jmeter-results.jtl \
                                  -j ci-app/target/jmeter.log
                            else
                                echo "Plan JMeter absent : etape ignoree."
                            fi
                        '''
                    } else {
                        echo 'Repertoire jmeter absent : etape ignoree.'
                    }
                }
            }
        }

        stage('Archive') {
            steps {
                echo '=== Archivage des artefacts ==='

                archiveArtifacts(
                    artifacts: 'ci-app/target/*.war',
                    allowEmptyArchive: false,
                    fingerprint: true
                )

                archiveArtifacts(
                    artifacts: 'ci-app/target/site/jacoco/**',
                    allowEmptyArchive: true,
                    fingerprint: true
                )

                archiveArtifacts(
                    artifacts: 'ci-app/target/surefire-reports/*.xml',
                    allowEmptyArchive: true,
                    fingerprint: true
                )

                archiveArtifacts(
                    artifacts: 'ci-app/target/jmeter-results.jtl,ci-app/target/jmeter.log',
                    allowEmptyArchive: true,
                    fingerprint: true
                )
            }
        }

        stage('Docker Build, Trivy Scan and Docker Hub Push') {
            agent {
                label 'docker-trivy'
            }

            steps {
                echo '=== Recuperation Nexus, Docker Build, Trivy et Docker Hub ==='

                deleteDir()

                withCredentials([
                    usernamePassword(
                        credentialsId: 'nexus-credentials',
                        usernameVariable: 'NEXUS_USER',
                        passwordVariable: 'NEXUS_PASSWORD'
                    )
                ]) {
                    sh '''
                        set -eu

                        mkdir -p ci-app/target

                        METADATA_URL="${NEXUS_URL}/repository/${NEXUS_REPOSITORY}/${NEXUS_GROUP_PATH}/maven-metadata.xml"

                        echo "=== Lecture des metadonnees Nexus ==="

                        curl --fail --silent --show-error \
                          --user "$NEXUS_USER:$NEXUS_PASSWORD" \
                          --output /tmp/maven-metadata.xml \
                          "$METADATA_URL"

                        echo "=== Resolution du dernier snapshot WAR ==="

                        SNAPSHOT_VERSION=$(python3 -c '
import xml.etree.ElementTree as ET

root = ET.parse("/tmp/maven-metadata.xml").getroot()

ns = (
    {"m": root.tag.split("}")[0].strip("{")}
    if "}" in root.tag else {}
)

nodes = (
    root.findall(".//m:snapshotVersion", ns)
    if ns else root.findall(".//snapshotVersion")
)

for node in nodes:
    extension = (
        node.findtext("m:extension", default="", namespaces=ns)
        if ns else node.findtext("extension", default="")
    )

    classifier = (
        node.findtext("m:classifier", default="", namespaces=ns)
        if ns else node.findtext("classifier", default="")
    )

    value = (
        node.findtext("m:value", default="", namespaces=ns)
        if ns else node.findtext("value", default="")
    )

    if extension == "war" and not classifier and value:
        print(value)
        break
')

                        if [ -z "$SNAPSHOT_VERSION" ]; then
                            echo "ERREUR : aucun WAR snapshot trouve dans Nexus."
                            exit 1
                        fi

                        echo "Snapshot trouve : $SNAPSHOT_VERSION"

                        WAR_URL="${NEXUS_URL}/repository/${NEXUS_REPOSITORY}/${NEXUS_GROUP_PATH}/ci-app-${SNAPSHOT_VERSION}.war"

                        echo "=== Telechargement du WAR depuis Nexus ==="

                        curl --fail --silent --show-error \
                          --user "$NEXUS_USER:$NEXUS_PASSWORD" \
                          --output ci-app/target/ci-app-1.0-SNAPSHOT.war \
                          "$WAR_URL"

                        test -s ci-app/target/ci-app-1.0-SNAPSHOT.war

                        ls -lh ci-app/target/ci-app-1.0-SNAPSHOT.war
                    '''
                }

                sh '''
                    set -eu

                    cat > Dockerfile <<'EOF'
FROM tomcat:9.0-jdk21-temurin-noble

RUN rm -rf /usr/local/tomcat/webapps/* \
    && (getent group tomcat >/dev/null || groupadd --system tomcat) \
    && (id -u tomcat >/dev/null 2>&1 || \
        useradd --system --gid tomcat \
        --home-dir /usr/local/tomcat \
        --no-create-home tomcat) \
    && chown -R tomcat:tomcat /usr/local/tomcat

COPY --chown=tomcat:tomcat ci-app/target/ci-app-1.0-SNAPSHOT.war /usr/local/tomcat/webapps/ci-app.war

EXPOSE 8080

USER tomcat

HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
    CMD bash -c 'cat < /dev/null > /dev/tcp/127.0.0.1/8080' || exit 1

CMD ["catalina.sh", "run"]
EOF

                    echo "=== Dockerfile genere ==="
                    cat Dockerfile
                '''

                withCredentials([
                    string(
                        credentialsId: 'DOCKERHUB_TOKEN',
                        variable: 'DOCKERHUB_TOKEN'
                    )
                ]) {
                    sh '''
                        set -eu

                        IMAGE="${DOCKER_IMAGE}"
                        BUILD_TAG="${IMAGE}:${BUILD_NUMBER}"

                        echo "=== Construction de ${BUILD_TAG} ==="

                        docker build --pull \
                          -t "$BUILD_TAG" \
                          -t "${IMAGE}:latest" \
                          .

                        echo "=== Scan Trivy HIGH / CRITICAL ==="

                        trivy image \
                          --timeout 15m \
                          --severity HIGH,CRITICAL \
                          --ignore-unfixed \
                          --exit-code 1 \
                          "$BUILD_TAG"

                        echo "=== Scan Trivy termine sans findings bloquants ==="

                        echo "=== Connexion Docker Hub ==="

                        printf '%s' "$DOCKERHUB_TOKEN" |
                          docker login \
                            --username "Insafnemri" \
                            --password-stdin

                        echo "=== Publication Docker Hub ==="

                        docker push "$BUILD_TAG"
                        docker push "${IMAGE}:latest"

                        echo "=== Images publiees ==="
                        echo "$BUILD_TAG"
                        echo "${IMAGE}:latest"

                        docker logout
                    '''
                }
            }

            post {
                always {
                    echo '=== Fin de l etape Docker / Trivy ==='
                }
            }
        }
    }

    post {
        success {
            echo '=== CI/CD SUCCESS : Pipeline termine avec succes ==='
        }

        failure {
            echo '=== CI/CD FAILURE : Verifier les logs Jenkins ==='
        }

        always {
            cleanWs()
        }
    }
}
