pipeline {
    agent none

    options {
        timestamps()
        timeout(time: 60, unit: 'MINUTES')
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
    }

    environment {
        GIT_URL         = 'https://github.com/INSAF-DEBUG/CI-Lab.git'
        NEXUS_URL       = 'http://192.168.42.128:8081'
        NEXUS_REPO      = 'maven-snapshots'
        GROUP_PATH      = 'com/insaf/cilab/ci-app'
        WAR_FILE        = 'ci-app-1.0-SNAPSHOT.war'
        DOCKER_IMAGE    = 'insafnemri/ci-app'
        DOCKER_TAG      = "${BUILD_NUMBER}"

        // Cache Trivy deja telecharge sur la VM docker-trivy (utilisateur trivy)
        TRIVY_CACHE_DIR = '/home/trivy/.cache/trivy'
    }

    stages {

        stage('1 - Checkout Git') {
            agent { label 'centos-build' }

            steps {
                deleteDir()

                sh '''
                    set -eu

                    git --version
                    git config --global http.version HTTP/1.1
                    git init .
                    git remote add origin "$GIT_URL"
                    git config core.compression 0

                    attempt=1
                    until git -c http.version=HTTP/1.1 fetch \
                        --no-tags origin \
                        +refs/heads/main:refs/remotes/origin/main
                    do
                        if [ "$attempt" -ge 3 ]; then
                            echo "ERREUR : echec du checkout Git"
                            exit 1
                        fi
                        attempt=$((attempt + 1))
                        sleep 3
                    done

                    git checkout -B main refs/remotes/origin/main

                    test -f ci-app/pom.xml

                    echo "Fichiers du projet :"
                    find ci-app -maxdepth 2 -type f | head -40

                    git log -1 --oneline
                '''

                stash(
                    name: 'source-code',
                    includes: 'ci-app/**',
                    useDefaultExcludes: false
                )
            }
        }

        stage('2 - Verification Java et Maven') {
            agent { label 'centos-build' }

            steps {
                sh '''
                    set -eu
                    java -version
                    mvn -version
                '''
            }
        }

        stage('3 - Build Maven') {
            agent { label 'centos-build' }

            steps {
                deleteDir()
                unstash 'source-code'

                dir('ci-app') {
                    sh '''
                        set -eu
                        mvn -B clean package -DskipTests
                        test -s target/ci-app-1.0-SNAPSHOT.war
                        ls -lh target/ci-app-1.0-SNAPSHOT.war
                    '''

                    archiveArtifacts(
                        artifacts: 'target/ci-app-1.0-SNAPSHOT.war',
                        fingerprint: true
                    )
                }

                stash(
                    name: 'built-war',
                    includes: 'ci-app/target/ci-app-1.0-SNAPSHOT.war'
                )
            }
        }

        stage('4 - Tests et couverture JaCoCo') {
            agent { label 'centos-build' }

            steps {
                deleteDir()
                unstash 'source-code'

                dir('ci-app') {
                    sh '''
                        set -eu
                        export MOZ_HEADLESS=1

                        mvn -B \
                          org.jacoco:jacoco-maven-plugin:0.8.12:prepare-agent \
                          test \
                          org.jacoco:jacoco-maven-plugin:0.8.12:report
                    '''
                }
            }

            post {
                always {
                    junit(
                        testResults: 'ci-app/target/surefire-reports/*.xml',
                        allowEmptyResults: true
                    )

                    archiveArtifacts(
                        artifacts: 'ci-app/target/site/jacoco/**',
                        allowEmptyArchive: true
                    )
                }
            }
        }

        stage('5 - Publication du WAR dans Nexus') {
            agent { label 'centos-build' }

            steps {
                deleteDir()
                unstash 'source-code'
                unstash 'built-war'

                dir('ci-app') {
                    withCredentials([
                        usernamePassword(
                            credentialsId: 'nexus-credentials',
                            usernameVariable: 'NEXUS_USER',
                            passwordVariable: 'NEXUS_PASSWORD'
                        )
                    ]) {
                        sh '''
                            set -eu

                            SETTINGS="$WORKSPACE/nexus-settings.xml"

                            cat > "$SETTINGS" <<EOF
<settings>
  <servers>
    <server>
      <id>jenkins-nexus</id>
      <username>${NEXUS_USER}</username>
      <password>${NEXUS_PASSWORD}</password>
    </server>
  </servers>
</settings>
EOF

                            mvn -B \
                              -s "$SETTINGS" \
                              org.apache.maven.plugins:maven-deploy-plugin:2.8.2:deploy-file \
                              -Dfile=target/ci-app-1.0-SNAPSHOT.war \
                              -DpomFile=pom.xml \
                              -DrepositoryId=jenkins-nexus \
                              -Durl="$NEXUS_URL/repository/$NEXUS_REPO/" \
                              -DretryFailedDeploymentCount=3

                            rm -f "$SETTINGS"
                        '''
                    }
                }
            }
        }

        stage('6 - Recuperation du WAR depuis Nexus') {
            agent { label 'centos-build' }

            steps {
                deleteDir()

                withCredentials([
                    usernamePassword(
                        credentialsId: 'nexus-credentials',
                        usernameVariable: 'NEXUS_USER',
                        passwordVariable: 'NEXUS_PASSWORD'
                    )
                ]) {
                    sh '''
                        set -eu

                        mkdir -p docker-context

                        BASE_URL="$NEXUS_URL/repository/$NEXUS_REPO/$GROUP_PATH/1.0-SNAPSHOT"
                        META_FILE="$WORKSPACE/maven-metadata.xml"

                        curl -fsSL \
                          --retry 3 \
                          -u "$NEXUS_USER:$NEXUS_PASSWORD" \
                          "$BASE_URL/maven-metadata.xml" \
                          -o "$META_FILE"

                        SNAPSHOT_VALUE=$(awk '
                            /<snapshotVersion>/ { block=1; ext=0; value="" }
                            block && /<extension>war<\\/extension>/ { ext=1 }
                            block && /<value>/ {
                                gsub(/.*<value>/, "")
                                gsub(/<\\/value>.*/, "")
                                value=$0
                            }
                            block && /<\\/snapshotVersion>/ {
                                if (ext && value != "") {
                                    print value
                                    exit
                                }
                                block=0
                            }
                        ' "$META_FILE")

                        if [ -n "$SNAPSHOT_VALUE" ]; then
                            ARTIFACT_URL="$BASE_URL/ci-app-$SNAPSHOT_VALUE.war"
                        else
                            ARTIFACT_URL="$BASE_URL/ci-app-1.0-SNAPSHOT.war"
                        fi

                        echo "Telechargement du WAR depuis Nexus"
                        echo "$ARTIFACT_URL"

                        curl -fSL \
                          --retry 3 \
                          -u "$NEXUS_USER:$NEXUS_PASSWORD" \
                          "$ARTIFACT_URL" \
                          -o "docker-context/$WAR_FILE"

                        test -s "docker-context/$WAR_FILE"
                        ls -lh "docker-context/$WAR_FILE"
                    '''
                }

                stash(
                    name: 'nexus-war',
                    includes: 'docker-context/ci-app-1.0-SNAPSHOT.war'
                )
            }
        }

        stage('7 - Construction de l image Docker') {
            agent { label 'docker-trivy' }

            steps {
                deleteDir()
                unstash 'nexus-war'

                sh '''
                    set -eu

                    command -v docker

                    cp "docker-context/$WAR_FILE" "$WAR_FILE"

                    cat > Dockerfile <<'EOF'
FROM tomcat:9.0-jdk8-temurin
RUN rm -rf /usr/local/tomcat/webapps/*
COPY ci-app-1.0-SNAPSHOT.war /usr/local/tomcat/webapps/ROOT.war
EXPOSE 8080
CMD ["catalina.sh", "run"]
EOF

                    docker build \
                      -f Dockerfile \
                      -t "$DOCKER_IMAGE:$DOCKER_TAG" \
                      -t "$DOCKER_IMAGE:latest" \
                      .

                    docker image inspect "$DOCKER_IMAGE:$DOCKER_TAG"
                '''
            }
        }

        stage('8 - Analyse de securite Trivy') {
            agent { label 'docker-trivy' }

            steps {
                sh '''
                    set -eu

                    # La base de vulnerabilites doit deja etre en cache :
                    # on ne la telecharge pas pendant le build (reseau instable).
                    if [ ! -f "$TRIVY_CACHE_DIR/db/trivy.db" ]; then
                        echo "ERREUR : base Trivy absente dans $TRIVY_CACHE_DIR/db"
                        echo "Telechargez-la manuellement sur la VM docker-trivy."
                        exit 1
                    fi

                    # CVE acceptees (binaire pebble de l'image de base, non utilise)
                    cat > .trivyignore <<'EOF'
CVE-2026-78667
CVE-2026-78669
CVE-2026-97031
EOF

                    trivy image \
                      --cache-dir "$TRIVY_CACHE_DIR" \
                      --skip-db-update \
                      --skip-java-db-update \
                      --scanners vuln \
                      --ignorefile .trivyignore \
                      --timeout 10m \
                      --exit-code 1 \
                      --severity CRITICAL,HIGH \
                      "$DOCKER_IMAGE:$DOCKER_TAG"
                '''
            }
        }

        stage('9 - Publication Docker Hub') {
            agent { label 'docker-trivy' }

            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-credentials',
                        usernameVariable: 'DOCKERHUB_USER',
                        passwordVariable: 'DOCKERHUB_PASSWORD'
                    )
                ]) {
                    sh '''
                        set -eu

                        echo "$DOCKERHUB_PASSWORD" |
                          docker login \
                            --username "$DOCKERHUB_USER" \
                            --password-stdin

                        docker push "$DOCKER_IMAGE:$DOCKER_TAG"
                        docker push "$DOCKER_IMAGE:latest"

                        docker logout
                    '''
                }
            }
        }

        stage('10 - Deploiement Docker Swarm') {
            agent { label 'docker-trivy' }

            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-credentials',
                        usernameVariable: 'DOCKERHUB_USER',
                        passwordVariable: 'DOCKERHUB_PASSWORD'
                    )
                ]) {
                    sh '''
                        set -eu

                        echo "$DOCKERHUB_PASSWORD" |
                          docker login \
                            --username "$DOCKERHUB_USER" \
                            --password-stdin

                        docker pull "$DOCKER_IMAGE:$DOCKER_TAG"

                        if docker service inspect app-cd >/dev/null 2>&1; then
                            docker service update \
                              --image "$DOCKER_IMAGE:$DOCKER_TAG" \
                              --with-registry-auth \
                              app-cd
                        else
                            docker service create \
                              --name app-cd \
                              --publish 8080:8080 \
                              --with-registry-auth \
                              "$DOCKER_IMAGE:$DOCKER_TAG"
                        fi

                        docker logout

                        docker service ls
                        docker service ps app-cd
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'Pipeline execute avec succes.'
        }

        failure {
            echo 'Pipeline en echec. Consulter la premiere erreur dans Console Output.'
        }

        always {
            echo 'Fin du pipeline.'
        }
    }
}
