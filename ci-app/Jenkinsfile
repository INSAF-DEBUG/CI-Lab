stage('Archive') { steps { archiveArtifacts( artifacts: 'ci-app/target/*.war', fingerprint: true, allowEmptyArchive: false )

archiveArtifacts( artifacts: 'ci-app/target/site/jacoco/', fingerprint: true, allowEmptyArchive: true )

archiveArtifacts( artifacts: 'ci-app/target/surefire-reports/', fingerprint: true, allowEmptyArchive: true )

archiveArtifacts( artifacts: 'ci-app/target/*-results.jtl', fingerprint: true, allowEmptyArchive: true ) } } }

post { success { echo '=== CI SUCCESS ===' }

failure { echo '=== CI FAILURE ===' }

unstable { echo '=== CI UNSTABLE ===' }

aborted { echo '=== CI ABORTED ===' }

always { script { def finalStatus = currentBuild.currentResult ?: 'UNKNOWN' def statusColor = '#666666'

if (finalStatus == 'SUCCESS') { statusColor = '#228B22' } else if (finalStatus == 'FAILURE') { statusColor = '#CC0000' } else if (finalStatus == 'UNSTABLE') { statusColor = '#E69500' } else if (finalStatus == 'ABORTED') { statusColor = '#666666' }

def emailSubject = "[${finalStatus}] {env.JOB_NAME} - Build #{env.BUILD_NUMBER}"

def emailBody = """ <html> <body style="font-family: Arial, sans-serif;"> <h2 style="color: ${statusColor};"> Notification Jenkins : ${finalStatus} </h2> <p>Bonjour,</p> <p>Le pipeline CI/CD Jenkins est terminé.</p>

<table border="1" cellpadding="8" cellspacing="0" style="border-collapse: collapse;"> <tr> <td><b>Projet</b></td> <td>{env.JOB_NAME}</td> </tr> <tr> <td><b>Build</b></td> <td>#{env.BUILD_NUMBER}</td> </tr> <tr> <td><b>Statut</b></td> <td style="color: 
