pipeline {
    agent none

    options {
        timestamps()
        timeout(time: 60, unit: 'MINUTES')
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
    }

    environment {
        GIT_URL       = 'https://github.com/INSAF-DEBUG/CI-Lab.git'
        GIT_BRANCH    = '*/main'

        NEXUS_URL     = 'http://192.168.42.128:8081'
        NEXUS_REPO    = 'maven-snapshots'
        WAR_PATH      = 'com/insaf/cilab/ci-app/1.0-SNAPSHOT/ci-app-1.0-SNAPSHOT.war'

        DOCKER_IMAGE  = 'insafnemri/ci-app'
        DOCKER_TAG    = "${BUILD_NUMBER}"

        DOCKERFILE    = 'Dockerfile'
        WAR_FILE      = 'ci-app-1.0-SNAPSHOT.war'
    }

    stages {

        stage('1 - Checkout Git') {
            agent { label 'centos-build' }

            steps {
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: "${GIT_BRANCH}"]],
                    userRemoteConfigs: [[url: "${GIT_URL}"]]
                ])

                sh '''
                    set -eu
                    test -f ci-app/pom.xml
                    echo "Repository recupere"
                    git log -1 --oneline
                '''

                stash name: 'source-code',
                      includes: 'ci-app/**,Dockerfile',
                      allowEmpty: true
            }
        }

        stage('2 - Verification Java et Maven') {
            agent { label 'centos-build' }

            steps {
                sh '''
                    set -eu
                    java -version
                    mvn -version
                    command -v git
                '''
            }
        }

        stage('3 - Build Maven') {
            agent { label 'centos-build' }

            steps {
                unstash 'source-code'

                dir('ci-app') {
                    sh '''
                        set -eu
                        mvn -B clean package -DskipTests
                        test -s target/ci-app-1.0-SNAPSHOT.war
                    '''

                    archiveArtifacts(
                        artifacts: 'target/ci-app-1.0-SNAPSHOT.war',
                        fingerprint: true
                    )
                }

                stash name: 'war-artifact',
                      includes: 'ci-app/target/ci-app-1.0-SNAPSHOT.war'
            }
        }

        stage('4 - Tests et couverture JaCoCo') {
            agent { label 'centos-build' }

            steps {
                unstash 'source-code'
                unstash 'war-artifact'

                dir('ci-app') {
                    sh '''
                        set -eu
                        export MOZ_HEADLESS=1

                        mvn -B \
                          org.jacoco:jacoco-maven-plugin:0.8.12:prepare-agent \
                          test \
                          org.jacoco:jacoco-maven-plugin:0.8.12:report

                        test -f target/site/jacoco/index.html
                        test -f target/site/jacoco/jacoco.xml
                    '''
                }
            }

            post {
                always {
                    junit(
                        testResults: 'ci-app/target/surefire-reports/*.xml',
                        allowEmptyResults: true
                    )

                    archiveArtifacts(
                        artifacts: 'ci-app/target/site/jacoco/**',
                        allowEmptyArchive: true
                    )
                }
            }
        }

        stage('5 - Publication Maven vers Nexus') {
            agent { label 'centos-build' }

            steps {
                unstash 'source-code'
                unstash 'war-artifact'

                dir('ci-app') {
                    withCredentials([
                        usernamePassword(
                            credentialsId: 'nexus-credentials',
                            usernameVariable: 'NEXUS_USER',
                            passwordVariable: 'NEXUS_PASSWORD'
                        )
                    ]) {
                        sh '''
                            set -eu

                            curl -fsS \
                              --connect-timeout 10 \
                              -u "$NEXUS_USER:$NEXUS_PASSWORD" \
                              "$NEXUS_URL/" \
                              -o /dev/null

                            mvn -B deploy -DskipTests
                        '''
                    }
                }
            }
        }

        stage('6 - Telechargement WAR depuis Nexus') {
            agent { label 'centos-build' }

            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'nexus-credentials',
                        usernameVariable: 'NEXUS_USER',
                        passwordVariable: 'NEXUS_PASSWORD'
                    )
                ]) {
                    sh '''
                        set -eu

                        mkdir -p docker-context

                        curl -fSL \
                          --connect-timeout 10 \
                          --retry 3 \
                          -u "$NEXUS_USER:$NEXUS_PASSWORD" \
                          "$NEXUS_URL/repository/$NEXUS_REPO/$WAR_PATH" \
                          -o "docker-context/$WAR_FILE"

                        test -s "docker-context/$WAR_FILE"
                    '''
                }

                stash name: 'docker-war',
                      includes: 'docker-context/ci-app-1.0-SNAPSHOT.war'
            }
        }

        stage('7 - Build image Docker') {
            agent { label 'docker-trivy' }

            steps {
                unstash 'docker-war'

                // Le Dockerfile doit être disponible sur cet agent.
                // Le stash ci-dessous évite un checkout Git.
                unstash 'source-code'

                sh '''
                    set -eu

                    command -v docker
                    test -s docker-context/ci-app-1.0-SNAPSHOT.war
                    test -f Dockerfile

                    cp docker-context/ci-app-1.0-SNAPSHOT.war .

                    docker build \
                      -f Dockerfile \
                      -t "$DOCKER_IMAGE:$DOCKER_TAG" \
                      -t "$DOCKER_IMAGE:latest" \
                      .
                '''
            }
        }

        stage('8 - Scan securite Trivy') {
            agent { label 'docker-trivy' }

            steps {
                sh '''
                    set -eu

                    command -v trivy

                    trivy image \
                      --exit-code 1 \
                      --severity CRITICAL,HIGH \
                      "$DOCKER_IMAGE:$DOCKER_TAG"
                '''
            }
        }

        stage('9 - Push Docker Hub') {
            agent { label 'docker-trivy' }

            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-credentials',
                        usernameVariable: 'DOCKERHUB_USER',
                        passwordVariable: 'DOCKERHUB_PASSWORD'
                    )
                ]) {
                    sh '''
                        set -eu

                        echo "$DOCKERHUB_PASSWORD" |
                          docker login \
                            -u "$DOCKERHUB_USER" \
                            --password-stdin

                        docker push "$DOCKER_IMAGE:$DOCKER_TAG"
                        docker push "$DOCKER_IMAGE:latest"

                        docker logout
                    '''
                }
            }
        }

        stage('10 - Deploiement Docker Swarm') {
            agent { label 'docker-trivy' }

            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-credentials',
                        usernameVariable: 'DOCKERHUB_USER',
                        passwordVariable: 'DOCKERHUB_PASSWORD'
                    )
                ]) {
                    sh '''
                        set -eu

                        docker pull "$DOCKER_IMAGE:$DOCKER_TAG"

                        docker service update \
                          --image "$DOCKER_IMAGE:$DOCKER_TAG" \
                          --with-registry-auth \
                          app-cd || \
                        docker service create \
                          --name app-cd \
                          --publish 8080:8080 \
                          --with-registry-auth \
                          "$DOCKER_IMAGE:$DOCKER_TAG"
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'Pipeline termine avec succes.'
        }

        failure {
            echo 'Pipeline en echec. Consulter la Console Output.'
        }

        always {
            echo 'Fin du pipeline.'
        }
    }
}
