kpipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                echo '=== Checkout Git ==='
                checkout scm
            }
        }

        stage('Build') {
            steps {
                echo '=== Build Maven ==='
                dir('ci-app') {
                    sh 'mvn clean package -DskipTests'
                }
            }
        }

        stage('Tests') {
            steps {
                echo '=== Tests Maven ==='
                dir('ci-app') {
                    sh 'mvn test'
                }
            }
        }

        stage('Archive') {
            steps {
                echo '=== Archivage du JAR ==='
                archiveArtifacts artifacts: 'ci-app/target/*.jar', fingerprint: true
            }
        }
    }

    post {
        success {
            echo '=== CI SUCCESS ==='
        }

        failure {
            echo '=== CI FAILURE ==='
        }
    }
}

