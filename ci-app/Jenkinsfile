pipeline {

    agent {
        label 'centos-build'
    }

    environment {
        // Java utilisé par l'agent Jenkins
        JAVA_HOME = '/opt/java/jdk-21.0.4+7'
        PATH = "${JAVA_HOME}/bin:${env.PATH}"

        // À ADAPTER avec l'URL réelle de ton application
        // Exemple : APP_URL = 'http://192.168.1.100:8080/ci-app'
    }

    stages {

        stage('Checkout') {
            steps {
                echo '=== Checkout Git ==='
                checkout scm
            }
        }

        stage('Check Java') {
            steps {
                echo '=== Vérification Java / Maven ==='

                sh '''
                    echo "=== JAVA_HOME ==="
                    echo "$JAVA_HOME"

                    echo "=== which java ==="
                    which java

                    echo "=== Java version ==="
                    java -version

                    echo "=== which javac ==="
                    which javac

                    echo "=== Maven ==="
                    which mvn
                    mvn -version
                '''
            }
        }

        stage('Build') {
            steps {
                echo '=== Build Maven ==='

                dir('ci-app') {
                    sh '''
                        mvn clean package -DskipTests
                    '''
                }
            }
        }

        stage('Tests') {
            steps {
                echo '=== Tests Maven ==='

                dir('ci-app') {
                    sh '''
                        export MOZ_HEADLESS=1
                        mvn test
                    '''
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                echo '=== Analyse SonarQube ==='

                dir('ci-app') {
                    withSonarQubeEnv('SonarQube') {
                        sh '''
                            echo "=== Java utilisé pour SonarQube ==="
                            echo "JAVA_HOME=$JAVA_HOME"
                            java -version

                            echo "=== Maven utilisé pour SonarQube ==="
                            mvn -version

                            echo "=== Analyse SonarQube ==="
                            mvn sonar:sonar -Dsonar.exclusions="**/*.js,**/*.ts,**/*.css"


                        '''
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                echo '=== Vérification Quality Gate ==='

                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Deploy to Nexus') {
            steps {
                echo '=== Déploiement vers Nexus ==='

                dir('ci-app') {
                    sh '''
                        mvn deploy -DskipTests
                    '''
                }
            }
        }

        stage('JMeter Load Test') {
            steps {
                echo '=== Test de charge JMeter ==='

                sh '''
                    if command -v jmeter >/dev/null 2>&1; then
                        echo "JMeter trouvé :"
                        jmeter --version
                    else
                        echo "JMeter non installé sur l'agent."
                        echo "Stage ignoré."
                    fi
                '''
            }
        }

        stage('Archive') {
            steps {
                echo '=== Archivage ==='

                archiveArtifacts artifacts: 'ci-app/target/*.war',
                                 fingerprint: true
            }
        }
    }

    post {

        success {
            echo '=== CI SUCCESS ==='
            echo 'Pipeline terminé avec succès.'
        }

        failure {
            echo '=== CI FAILURE ==='
            echo 'Le pipeline a échoué.'
        }

        always {
            echo '=== Pipeline terminé ==='

            junit allowEmptyResults: true,
                  testResults: 'ci-app/target/surefire-reports/*.xml'
        }
    }
}

