pipeline {

    agent {
        label 'centos-build'
    }

    environment {
        JAVA_HOME = '/opt/java/jdk-21.0.4+7'
        PATH = "${JAVA_HOME}/bin:${env.PATH}"

        MAVEN_OPTS = '-Xmx1024m'

        // Empêche SonarQube de chercher les fichiers JS/TS/CSS
        SONAR_USER_HOME = "${WORKSPACE}/.sonar"
    }

    stages {

        stage('Checkout') {
            steps {
                echo '=== Checkout Git ==='

                checkout scm
            }
        }

        stage('Check Java / Maven') {
            steps {
                sh '''
                    set -e

                    echo "=== JAVA_HOME ==="
                    echo "$JAVA_HOME"

                    echo "=== Java ==="
                    which java
                    java -version

                    echo "=== Maven ==="
                    which mvn
                    mvn -version
                '''
            }
        }

        stage('Build') {
            steps {
                echo '=== Build Maven ==='

                dir('ci-app') {
                    sh '''
                        set -e

                        echo "=== POM ==="
                        ls -l pom.xml

                        echo "=== Maven Build ==="
                        mvn clean package -DskipTests
                    '''
                }
            }
        }

        stage('Tests') {
            steps {
                echo '=== Tests Maven ==='

                dir('ci-app') {
                    sh '''
                        set -e

                        export MOZ_HEADLESS=1

                        echo "=== Maven Tests ==="
                        mvn test
                    '''
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                echo '=== Analyse SonarQube ==='

                dir('ci-app') {
                    withSonarQubeEnv('SonarQube') {
                        sh '''
                            set -e

                            echo "=== Java pour SonarQube ==="
                            echo "JAVA_HOME=$JAVA_HOME"
                            java -version

                            echo "=== Maven ==="
                            mvn -version

                            echo "=== SonarQube ==="

                            mvn sonar:sonar \
                              -Dsonar.projectKey=com.insaf.cilab:ci-app \
                              -Dsonar.projectName=ci-app \
                              -Dsonar.sources=src/main/java,src/main/webapp \
                              -Dsonar.tests=src/test/java \
                              -Dsonar.exclusions=**/target/**,**/*.js,**/*.ts,**/*.css \
                              -Dsonar.coverage.jacoco.xmlReportPaths=target/site/jacoco/jacoco.xml
                        '''
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                echo '=== Quality Gate SonarQube ==='

                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Deploy to Nexus') {
            steps {
                echo '=== Deploy Nexus ==='

                dir('ci-app') {
                    sh '''
                        set -e

                        if [ -f ./deploy-nexus.sh ]; then
                            chmod +x ./deploy-nexus.sh
                            ./deploy-nexus.sh
                        else
                            echo "deploy-nexus.sh absent - étape ignorée"
                        fi
                    '''
                }
            }
        }

        stage('JMeter Load Test') {
            steps {
                echo '=== JMeter Load Test ==='

                dir('ci-app') {
                    sh '''
                        set +e

                        if command -v jmeter >/dev/null 2>&1; then
                            echo "JMeter trouvé"
                            jmeter -n -t test.jmx -l target/jmeter-results.jtl
                        else
                            echo "JMeter non installé - étape ignorée"
                        fi

                        exit 0
                    '''
                }
            }
        }

        stage('Archive') {
            steps {
                echo '=== Archive artifacts ==='

                archiveArtifacts artifacts: '''
                    ci-app/target/*.war,
                    ci-app/target/site/jacoco/**,
                    ci-app/target/surefire-reports/**,
                    ci-app/target/jmeter-results.jtl
                ''',
                allowEmptyArchive: true,
                fingerprint: true
            }
        }
    }

    post {

        always {
            echo '=== Pipeline terminé ==='

            junit(
                testResults: 'ci-app/target/surefire-reports/*.xml',
                allowEmptyResults: true
            )
        }

        success {
            echo '=== CI SUCCESS ==='
            echo 'Build + Tests + SonarQube + Quality Gate terminés avec succès.'
        }

        failure {
            echo '=== CI FAILURE ==='
            echo 'Le pipeline a échoué.'
        }

        cleanup {
            echo '=== Cleanup ==='
        }
    }
}

