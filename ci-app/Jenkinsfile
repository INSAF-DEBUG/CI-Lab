pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                echo '=== Checkout Git ==='
                checkout scm
            }
        }

        stage('Build') {
            steps {
                echo '=== Build Maven ==='
                dir('ci-app') {
                    sh 'mvn clean package -DskipTests'
                }
            }
        }

        stage('Tests') {
            steps {
                echo '=== Tests Maven ==='
                dir('ci-app') {
                    sh 'mvn test'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                echo '=== Analyse SonarQube ==='
                dir('ci-app') {
                    withSonarQubeEnv('SonarQube') {
                        sh 'mvn sonar:sonar'
                    }
                }
            }
        }

        stage('Deploy to Nexus') {
            steps {
                echo '=== Déploiement vers Nexus ==='
                dir('ci-app') {
                    withCredentials([
                        usernamePassword(
                            credentialsId: 'nexus-credentials',
                            usernameVariable: 'NEXUS_USERNAME',
                            passwordVariable: 'NEXUS_PASSWORD'
                        )
                    ]) {
                        sh '''
                            mvn deploy \
                            -Dnexus.username="$NEXUS_USERNAME" \
                            -Dnexus.password="$NEXUS_PASSWORD"
                        '''
                    }
                }
            }
        }

        stage('JMeter Load Test') {
            steps {
                echo '=== Test de charge JMeter ==='

                sh '''
                    ssh -o BatchMode=yes insaf@192.168.42.172 \
                    "sudo -u jmeterapp /opt/jmeter/bin/jmeter -n \
                    -t /home/insaf/CI-Lab/tests/jmeter/ci-app-load-test.jmx \
                    -l /home/insaf/jmeter-jenkins-results/jenkins-jmeter.jtl \
                    -j /home/insaf/jmeter-jenkins-results/jenkins-jmeter.log"
                '''

                sh '''
                    scp insaf@192.168.42.172:/home/insaf/jmeter-jenkins-results/jenkins-jmeter.jtl .
                    scp insaf@192.168.42.172:/home/insaf/jmeter-jenkins-results/jenkins-jmeter.log .
                '''

                archiveArtifacts artifacts: 'jenkins-jmeter.jtl,jenkins-jmeter.log', fingerprint: true
            }
        }

        stage('Archive') {
            steps {
                echo '=== Archivage du JAR ==='
                archiveArtifacts artifacts: 'ci-app/target/*.jar', fingerprint: true
            }
        }
    }

    post {
        success {
            echo '=== CI SUCCESS ==='
        }

        failure {
            echo '=== CI FAILURE ==='
        }
    }
}
