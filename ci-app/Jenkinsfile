echo "Notification finale : ${finalStatus}"

try { emailext( to: "${env.EMAIL_TO}", subject: emailSubject, mimeType: 'text/html', body: emailBody ) echo 'Appel de notification finale effectué.' } catch (Exception e) { echo "Erreur de notification : ${e.getMessage()}" currentBuild.description = "Notification email en échec" } }

echo '=== Pipeline terminé ==='

cleanWs( deleteDirs: true, disableDeferredWipeout: true, notFailBuild: true ) } } }
