
pipeline {
    agent {
        label 'centos-build'
    }

    options {
        timestamps()
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
        timeout(time: 60, unit: 'MINUTES')
    }

    environment {
        // Java 17 : compilation et tests
        JAVA_HOME = '/opt/java/jdk-17.0.20.1+1'
        MAVEN_OPTS = '-Xmx1024m'

        // A VERIFIER sur l'agent avant le build
        SONAR_JAVA_HOME = '/opt/java/jdk-21'
        SONAR_MAVEN_HOME = '/opt/maven/apache-maven-3.9.11'

        // Git
        GIT_URL = 'https://github.com/INSAF-DEBUG/CI-Lab.git'
        APP_DIR = 'ci-app'

        // SonarQube
        SONAR_PROJECT_KEY = 'com.insaf.cilab:ci-app'
        SONAR_PROJECT_NAME = 'ci-app'

        // Nexus
        NEXUS_URL = 'http://192.168.42.128:8081'
        NEXUS_REPOSITORY = 'maven-snapshots'
        NEXUS_GROUP_PATH = 'com/insaf/cilab/ci-app/1.0-SNAPSHOT'

        // Docker Hub
        IMAGE_NAME = 'insafnemri/ci-app'
        DOCKERHUB_USER = 'insafnemri'

        // Image de base
        TOMCAT_IMAGE = 'tomcat:9.0-jdk21-temurin-noble'
    }

    stages {

        stage('1 - Checkout Git') {
            steps {
                echo '=== Recuperation du code source ==='

                checkout([
                    $class: 'GitSCM',
                    branches: [[name: '*/main']],
                    userRemoteConfigs: [[url: "${GIT_URL}"]]
                ])

                sh '''
                    set -eu
                    echo "Commit recupere :"
                    git log -1 --oneline
                    echo "Contenu du workspace :"
                    ls -la
                    test -f "$APP_DIR/pom.xml"
                '''
            }
        }

        stage('2 - Verification Java et Maven') {
            steps {
                echo '=== Verification de l'environnement de build ==='

                sh '''
                    set -eu

                    test -x "$JAVA_HOME/bin/java"

                    export PATH="$JAVA_HOME/bin:$PATH"

                    echo "Version Java :"
                    java -version

                    echo "Version Maven :"
                    mvn -version

                    echo "Verification du projet Maven :"
                    test -f "$APP_DIR/pom.xml"
                '''
            }
        }

        stage('3 - Build Maven') {
            steps {
                echo '=== Compilation et packaging ==='

                dir('ci-app') {
                    sh '''
                        set -eu

                        export PATH="$JAVA_HOME/bin:$PATH"

                        mvn -B clean package -DskipTests

                        echo "Verification du fichier WAR :"
                        test -s target/ci-app-1.0-SNAPSHOT.war
                        ls -lh target/ci-app-1.0-SNAPSHOT.war
                    '''
                }
            }
        }

        stage('4 - Tests unitaires et couverture') {
            steps {
                echo '=== Execution des tests et generation JaCoCo ==='

                dir('ci-app') {
                    sh '''
                        set -eu

                        export PATH="$JAVA_HOME/bin:$PATH"

                        mvn -B test jacoco:report

                        echo "Verification des rapports de tests :"
                        ls -la target/surefire-reports/

                        echo "Verification du rapport JaCoCo :"
                        test -s target/site/jacoco/jacoco.xml
                        ls -lh target/site/jacoco/jacoco.xml
                    '''
                }

                junit(
                    testResults: 'ci-app/target/surefire-reports/*.xml',
                    allowEmptyResults: false
                )

                archiveArtifacts(
                    artifacts: 'ci-app/target/site/jacoco/**,ci-app/target/surefire-reports/**',
                    allowEmptyArchive: true
                )
            }
        }

        stage('5 - Analyse SonarQube') {
            steps {
                echo '=== Analyse statique avec SonarQube ==='

                script {
                    if (!fileExists("${APP_DIR}/target/site/jacoco/jacoco.xml")) {
                        error('Rapport JaCoCo introuvable : analyse SonarQube annulee.')
                    }
                }

                withSonarQubeEnv('SonarQube') {
                    withEnv([
                        "JAVA_HOME=${SONAR_JAVA_HOME}",
                        "PATH=${SONAR_JAVA_HOME}/bin:${SONAR_MAVEN_HOME}/bin:${env.PATH}"
                    ]) {
                        dir('ci-app') {
                            sh '''
                                set -eu

                                echo "Java utilise pour SonarQube :"
                                test -x "$JAVA_HOME/bin/java"
                                java -version

                                echo "Maven utilise pour SonarQube :"
                                test -x "$SONAR_MAVEN_HOME/bin/mvn"
                                "$SONAR_MAVEN_HOME/bin/mvn" -version

                                test -s target/site/jacoco/jacoco.xml

                                "$SONAR_MAVEN_HOME/bin/mvn" -B \
                                  org.sonarsource.scanner.maven:sonar-maven-plugin:5.2.0.4988:sonar \
                                  -Dsonar.projectKey="$SONAR_PROJECT_KEY" \
                                  -Dsonar.projectName="$SONAR_PROJECT_NAME" \
                                  -Dsonar.sources=src/main/java \
                                  -Dsonar.tests=src/test/java \
                                  -Dsonar.exclusions="**/target/**,**/*.js,**/*.ts,**/*.css,**/src/main/webapp/**" \
                                  -Dsonar.coverage.jacoco.xmlReportPaths=target/site/jacoco/jacoco.xml
                            '''
                        }
                    }
                }
            }
        }

        stage('6 - Quality Gate') {
            steps {
                echo '=== Attente du Quality Gate ==='

                timeout(time: 10, unit: 'MINUTES') {
                    waitForQualityGate(abortPipeline: true)
                }
            }
        }

        stage('7 - Publication sur Nexus') {
            steps {
                echo '=== Publication de l artefact Maven ==='

                dir('ci-app') {
                    sh '''
                        set -eu

                        export PATH="$JAVA_HOME/bin:$PATH"

                        mvn -B deploy -DskipTests

                        echo "Publication Maven terminee."
                    '''
                }
            }
        }

        stage('8 - Tests de charge JMeter') {
            when {
                expression {
                    fileExists('jmeter/test-plan.jmx')
                }
            }

            steps {
                echo '=== Execution des tests de charge ==='

                sh '''
                    set -eu

                    mkdir -p jmeter/results

                    if [ -x jmeter/apache-jmeter/bin/jmeter ]; then
                        JMETER="jmeter/apache-jmeter/bin/jmeter"
                    elif command -v jmeter >/dev/null 2>&1; then
                        JMETER="$(command -v jmeter)"
                    else
                        echo "ERREUR : JMeter est introuvable."
                        exit 1
                    fi

                    "$JMETER" -n \
                      -t jmeter/test-plan.jmx \
                      -l "jmeter/results/results-${BUILD_NUMBER}.jtl" \
                      -j "jmeter/results/jmeter-${BUILD_NUMBER}.log"
                '''

                archiveArtifacts(
                    artifacts: 'jmeter/results/*.jtl,jmeter/results/*.log',
                    allowEmptyArchive: true
                )
            }
        }

        stage('9 - Archivage du WAR') {
            steps {
                echo '=== Archivage des artefacts ==='

                archiveArtifacts(
                    artifacts: 'ci-app/target/*.war,ci-app/target/site/jacoco/**,ci-app/target/surefire-reports/**',
                    allowEmptyArchive: false
                )
            }
        }

        stage('10 - Docker : construction et publication') {
            agent {
                label 'docker-trivy'
            }

            steps {
                echo '=== Preparation de l artefact depuis Nexus ==='

                deleteDir()

                sh '''
                    set -eu

                    command -v curl >/dev/null 2>&1
                    command -v python3 >/dev/null 2>&1
                    command -v docker >/dev/null 2>&1
                    command -v trivy >/dev/null 2>&1

                    mkdir -p ci-app/target

                    METADATA_FILE="$(mktemp)"

                    trap 'rm -f "$METADATA_FILE"' EXIT

                    METADATA_URL="$NEXUS_URL/repository/$NEXUS_REPOSITORY/$NEXUS_GROUP_PATH/maven-metadata.xml"

                    echo "Lecture des metadonnees Nexus : $METADATA_URL"

                    curl -fsS "$METADATA_URL" -o "$METADATA_FILE"

                    SNAPSHOT_VERSION="$(python3 - "$METADATA_FILE" <<'PY'
import sys
import xml.etree.ElementTree as ET

root = ET.parse(sys.argv[1]).getroot()

for item in root.findall("./versioning/snapshotVersions/snapshotVersion"):
    extension = item.findtext("extension")
    classifier = item.findtext("classifier")
    value = item.findtext("value")

    if extension == "war" and not classifier and value:
        print(value)
        break
else:
    raise SystemExit("Aucune version snapshot WAR trouvee dans Nexus")
PY
                    )"

                    echo "Version snapshot detectee : $SNAPSHOT_VERSION"

                    WAR_URL="$NEXUS_URL/repository/$NEXUS_REPOSITORY/$NEXUS_GROUP_PATH/ci-app-${SNAPSHOT_VERSION}.war"

                    curl -fSL "$WAR_URL" \
                      -o ci-app/target/ci-app-1.0-SNAPSHOT.war

                    test -s ci-app/target/ci-app-1.0-SNAPSHOT.war

                    ls -lh ci-app/target/ci-app-1.0-SNAPSHOT.war
                '''

                echo '=== Creation du Dockerfile ==='

                sh '''
                    set -eu

                    cat > Dockerfile <<'EOF'
FROM tomcat:9.0-jdk21-temurin-noble

RUN rm -rf /usr/local/tomcat/webapps/*

COPY --chown=tomcat:tomcat ci-app/target/ci-app-1.0-SNAPSHOT.war /usr/local/tomcat/webapps/ROOT.war

USER tomcat

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD bash -c 'echo > /dev/tcp/127.0.0.1/8080' || exit 1

CMD ["catalina.sh", "run"]
EOF

                    echo "Dockerfile genere :"
                    cat Dockerfile
                '''

                echo '=== Construction de l image Docker ==='

                sh '''
                    set -eu

                    docker build \
                      --pull \
                      -t "$IMAGE_NAME:$BUILD_NUMBER" \
                      -t "$IMAGE_NAME:latest" \
                      .
                '''

                echo '=== Analyse de securite avec Trivy ==='

                sh '''
                    set -eu

                    trivy image \
                      --severity HIGH,CRITICAL \
                      --ignore-unfixed \
                      --exit-code 1 \
                      "$IMAGE_NAME:$BUILD_NUMBER"
                '''

                echo '=== Publication sur Docker Hub ==='

                withCredentials([
                    string(
                        credentialsId: 'DOCKERHUB_TOKEN',
                        variable: 'DOCKERHUB_TOKEN'
                    )
                ]) {
                    sh '''
                        set -eu

                        echo "$DOCKERHUB_TOKEN" | \
                          docker login \
                            --username "$DOCKERHUB_USER" \
                            --password-stdin

                        docker push "$IMAGE_NAME:$BUILD_NUMBER"
                        docker push "$IMAGE_NAME:latest"

                        docker logout
                    '''
                }
            }

            post {
                always {
                    sh '''
                        docker image rm \
                          "$IMAGE_NAME:$BUILD_NUMBER" \
                          "$IMAGE_NAME:latest" \
                          >/dev/null 2>&1 || true
                    '''
                }
            }
        }
    }

    post {
        success {
            echo "Pipeline CI/CD termine avec succes."
        }

        failure {
            echo "Pipeline en echec. Consulter les logs de l etape en erreur."
        }

        always {
            echo "Fin du build #${BUILD_NUMBER}."
            cleanWs()
        }
    }
}
