pipeline { agent { label 'centos-build' }

options { timestamps() skipDefaultCheckout() }

environment { JAVAHOME = '/opt/java/jdk-21.0.4+7' SONARPROJECTKEY = 'com.insaf.cilab:ci-app' SONARPROJECTNAME = 'ci-app' EMAILTO = 'nemriinsaf000@gmail.com' }

stages { stage('Checkout') { steps { checkout scm echo '=== Checkout Git terminé ===' } }

stage('Check Java / Maven') { steps { withEnv(["PATH+JAVA={env.JAVA_HOME}/bin"]) { sh ''' set -e echo "=== JAVA_HOME ===" echo "JAVA_HOME" java -version echo "=== Maven ===" mvn -version ''' } } }

stage('Test Email Notification') { steps { echo "Test email vers ${env.EMAIL_TO}"

emailext( to: "${env.EMAILTO}", subject: "[TEST PIPELINE] {env.JOB_NAME} - Build #{env.BUILDNUMBER}", mimeType: 'text/plain', body: """Test d'envoi depuis Jenkins.

Projet : {env.JOB_NAME} Build : #{env.BUILDNUMBER} URL : ${env.BUILDURL} """ ) } }

stage('Build') { steps { dir('ci-app') { withEnv(["PATH+JAVA=${env.JAVA_HOME}/bin"]) { sh ''' set -e test -f pom.xml mvn clean package -DskipTests ls -lh target/*.war ''' } } } }

stage('Tests') { steps { dir('ci-app') { withEnv(["PATH+JAVA=${env.JAVAHOME}/bin", 'MOZHEADLESS=1']) { sh ''' set -e mvn test ''' } } }

post { always { junit( allowEmptyResults: true, testResults: 'ci-app/target/surefire-reports/*.xml' ) } } }

stage('SonarQube Analysis') { steps { dir('ci-app') { withEnv(["PATH+JAVA=${env.JAVAHOME}/bin"]) { withSonarQubeEnv('SonarQube') { sh ''' set -e mvn sonar:sonar
-Dsonar.projectKey="$SONARPROJECTKEY"
-Dsonar.projectName="$SONARPROJECT_NAME"
-Dsonar.sources=src/main/java
-Dsonar.tests=src/test/java
-Dsonar.exclusions="/target/,/.js,/.ts,/.css,/src/main/webapp/*"
-Dsonar.coverage.jacoco.xmlReportPaths=target/site/jacoco/jacoco.xml ''' } } } } }

stage('Quality Gate') { steps { timeout(time: 10, unit: 'MINUTES') { waitForQualityGate abortPipeline: true } } }

stage('Deploy to Nexus') { steps { dir('ci-app') { withEnv(["PATH+JAVA=${env.JAVA_HOME}/bin"]) { sh ''' set -e ls -lh target/*.war mvn deploy -DskipTests ''' } } } }

stage('JMeter Load Test') { steps { script { if (!fileExists('ci-app/jmeter')) { echo 'Répertoire ci-app/jmeter absent : étape ignorée.' } else { dir('ci-app') { sh ''' set -e mkdir -p target

if ! command -v jmeter >/dev/null 2>&1; then echo "JMeter non installé : étape ignorée." exit 0 fi

found=0

for file in jmeter/*.jmx; do if [ -f "
