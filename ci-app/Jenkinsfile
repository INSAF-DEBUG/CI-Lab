
pipeline {
    agent {
        label 'centos-build'
    }

    options {
        timestamps()
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
        timeout(time: 60, unit: 'MINUTES')
    }

    parameters {
        booleanParam(
            name: 'ENABLE_SONAR',
            defaultValue: false,
            description: 'Activer analyse SonarQube et Quality Gate'
        )

        booleanParam(
            name: 'ENABLE_JMETER',
            defaultValue: false,
            description: 'Executer les tests de charge JMeter'
        )
    }

    environment {
        APP_DIR = 'ci-app'
        APP_NAME = 'ci-app'
        APP_VERSION = '1.0-SNAPSHOT'

        NEXUS_URL = 'http://192.168.42.128:8081'
        NEXUS_REPO = 'maven-snapshots'

        DOCKERHUB_USER = 'insafnemri'
        DOCKER_IMAGE = 'insafnemri/ci-app'

        WAR_FILE = 'ci-app/target/ci-app-1.0-SNAPSHOT.war'
    }

    stages {

        stage('1 - Checkout Git') {
            steps {
                checkout scm

                sh '''
                    echo "=== Depot Git ==="
                    git log -1 --oneline
                    echo "=== Fichiers du projet ==="
                    ls -la
                    ls -la ci-app
                '''
            }
        }

        stage('2 - Verification Java et Maven') {
            steps {
                sh '''
                    set -e

                    echo "=== Java ==="
                    java -version

                    echo "=== Maven ==="
                    mvn -version

                    echo "=== Docker disponible sur agent de build ==="
                    command -v git
                    command -v mvn
                '''
            }
        }

        stage('3 - Build Maven') {
            steps {
                dir('ci-app') {
                    sh '''
                        set -e
                        mvn -B clean package -DskipTests
                    '''
                }

                sh '''
                    set -e
                    test -s "$WAR_FILE"
                    ls -lh "$WAR_FILE"
                '''
            }
        }

        stage('4 - Tests et couverture JaCoCo') {
            steps {
                dir('ci-app') {
                    sh '''
                        set -e

                        # Active la collecte de couverture.
                        # MOZ_HEADLESS permet a Firefox de fonctionner
                        # sans interface graphique si Selenium est utilise.
                        export MOZ_HEADLESS=1

                        mvn -B \
                          org.jacoco:jacoco-maven-plugin:0.8.12:prepare-agent \
                          test \
                          org.jacoco:jacoco-maven-plugin:0.8.12:report
                    '''
                }
            }

            post {
                always {
                    junit(
                        testResults: 'ci-app/target/surefire-reports/*.xml',
                        allowEmptyResults: true
                    )

                    archiveArtifacts(
                        artifacts: 'ci-app/target/site/jacoco/**',
                        allowEmptyArchive: true
                    )
                }
            }
        }

        stage('5 - Analyse SonarQube') {
            when {
                expression {
                    return params.ENABLE_SONAR
                }
            }

            steps {
                dir('ci-app') {
                    withSonarQubeEnv('SonarQube') {
                        sh '''
                            set -e

                            mvn -B sonar:sonar \
                              -Dsonar.coverage.jacoco.xmlReportPaths=target/site/jacoco/jacoco.xml
                        '''
                    }
                }
            }
        }

        stage('6 - Quality Gate') {
            when {
                expression {
                    return params.ENABLE_SONAR
                }
            }

            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate(
                        abortPipeline: true
                    )
                }
            }
        }

        stage('7 - Publication Maven vers Nexus') {
            steps {
                dir('ci-app') {
                    sh '''
                        set -e

                        echo "=== Verification de la connexion Nexus ==="

                        curl -fsS \
                          --connect-timeout 5 \
                          "$NEXUS_URL/" \
                          -o /dev/null

                        echo "=== Publication de l'artefact ==="

                        mvn -B deploy -DskipTests
                    '''
                }
            }
        }

        stage('8 - Tests de charge JMeter') {
            when {
                expression {
                    return params.ENABLE_JMETER
                }
            }

            steps {
                sh '''
                    set -e

                    if ! command -v jmeter >/dev/null 2>&1; then
                        echo "ERREUR : JMeter n'est pas installe sur cet agent."
                        exit 1
                    fi

                    if [ ! -f tests/jmeter/ci-app.jmx ]; then
                        echo "ERREUR : fichier tests/jmeter/ci-app.jmx introuvable."
                        echo "Adapte le chemin au fichier JMX de ton projet."
                        exit 1
                    fi

                    mkdir -p reports/jmeter

                    jmeter -n \
                      -t tests/jmeter/ci-app.jmx \
                      -l reports/jmeter/results.jtl \
                      -e \
                      -o reports/jmeter/html-report
                '''
            }

            post {
                always {
                    archiveArtifacts(
                        artifacts: 'reports/jmeter/**',
                        allowEmptyArchive: true
                    )
                }
            }
        }

        stage('9 - Archivage et preparation WAR') {
            steps {
                sh '''
                    set -e

                    test -s "$WAR_FILE"

                    echo "=== Artefact WAR ==="
                    ls -lh "$WAR_FILE"
                '''

                archiveArtifacts(
                    artifacts: 'ci-app/target/ci-app-1.0-SNAPSHOT.war',
                    fingerprint: true
                )

                stash(
                    name: 'ci-app-war',
                    includes: 'ci-app/target/ci-app-1.0-SNAPSHOT.war'
                )
            }
        }

        stage('10 - Docker, Trivy et Docker Hub') {
            agent {
                label 'docker-trivy'
            }

            steps {
                unstash 'ci-app-war'

                sh '''
                    set -e

                    echo "=== Verification Docker ==="
                    docker --version
                    docker info

                    echo "=== Verification Trivy ==="
                    trivy --version

                    test -s "$WAR_FILE"

                    cat > Dockerfile <<'EOF'
FROM tomcat:9.0-jdk21-temurin-noble

LABEL maintainer="Insaf Nemri"
LABEL application="ci-app"

COPY ci-app/target/ci-app-1.0-SNAPSHOT.war \
     /usr/local/tomcat/webapps/ci-app.war

EXPOSE 8080

CMD ["catalina.sh", "run"]
EOF

                    echo "=== Construction de l'image ==="

                    docker build \
                      -t "$DOCKER_IMAGE:$BUILD_NUMBER" \
                      -t "$DOCKER_IMAGE:latest" \
                      .
                '''

                withCredentials([
                    string(
                        credentialsId: 'DOCKERHUB_TOKEN',
                        variable: 'DOCKERHUB_TOKEN'
                    )
                ]) {
                    sh '''
                        set -e

                        echo "=== Analyse de securite Trivy ==="

                        trivy image \
                          --severity HIGH,CRITICAL \
                          --ignore-unfixed \
                          --exit-code 1 \
                          "$DOCKER_IMAGE:$BUILD_NUMBER"

                        echo "=== Connexion Docker Hub ==="

                        echo "$DOCKERHUB_TOKEN" |
                          docker login \
                            -u "$DOCKERHUB_USER" \
                            --password-stdin

                        echo "=== Publication des images ==="

                        docker push "$DOCKER_IMAGE:$BUILD_NUMBER"
                        docker push "$DOCKER_IMAGE:latest"

                        docker logout
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'Pipeline CI/CD termine avec succes.'
        }

        failure {
            echo 'Pipeline en echec. Consulter la Console Output de Jenkins.'
        }

        always {
            echo 'Fin du pipeline.'
            cleanWs()
        }
    }
}
