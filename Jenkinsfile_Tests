
pipeline {

    agent {
        label 'centos-build'
    }

    environment {
        // Application
        APP_DIR = 'ci-app'

        // Firefox / Selenium
        DISPLAY = ':0'
        XAUTHORITY = '/home/insaf/.Xauthority'

        // SonarQube
        SONAR_HOST_URL = 'http://192.168.42.152:9000'

        // Nexus
        NEXUS_URL = 'http://192.168.42.154:8081'
    }

    stages {

        // ==========================================
        // 1. CHECKOUT
        // ==========================================
        stage('Checkout') {
            steps {
                echo '=== Récupération du code source Git ==='

                checkout scm
            }
        }

        // ==========================================
        // 2. BUILD MAVEN
        // ==========================================
        stage('Build') {
            steps {
                echo '=== Compilation de l application ==='

                dir("${APP_DIR}") {
                    sh '''
                        set -e

                        echo "=== Java ==="
                        java -version

                        echo "=== Maven ==="
                        mvn -version

                        echo "=== Compilation et génération du WAR ==="
                        mvn clean package -DskipTests
                    '''
                }
            }
        }

        // ==========================================
        // 3. TESTS UNITAIRES, INTEGRATION ET SELENIUM
        // ==========================================
        stage('Tests') {
            steps {
                echo '=== Tests Maven et Selenium Firefox ==='

                dir("${APP_DIR}") {
                    sh '''
                        set -e

                        echo "=== Environnement graphique ==="
                        echo "DISPLAY=$DISPLAY"
                        echo "XAUTHORITY=$XAUTHORITY"

                        echo "=== Vérification Xauthority ==="
                        test -f "$XAUTHORITY"

                        xauth -f "$XAUTHORITY" list || true

                        echo "=== Vérification Firefox ==="
                        firefox --version

                        echo "=== Exécution des tests Maven ==="
                        mvn test
                    '''
                }
            }
        }

        // ==========================================
        // 4. ANALYSE SONARQUBE
        // ==========================================
        stage('SonarQube Analysis') {
            steps {
                echo '=== Analyse de la qualité du code ==='

                dir("${APP_DIR}") {
                    withSonarQubeEnv('SonarQube') {
                        sh '''
                            set -e

                            mvn sonar:sonar \
                              -Dsonar.host.url="$SONAR_HOST_URL" \
                              -Dsonar.projectKey=ci-app \
                              -Dsonar.projectName=ci-app
                        '''
                    }
                }
            }
        }

        // ==========================================
        // 5. DEPLOIEMENT NEXUS
        // ==========================================
        stage('Deploy to Nexus') {
            steps {
                echo '=== Publication de l artefact Maven vers Nexus ==='

                dir("${APP_DIR}") {
                    sh '''
                        set -e

                        echo "=== Déploiement Maven vers Nexus ==="

                        mvn deploy -DskipTests
                    '''
                }
            }
        }

        // ==========================================
        // 6. ARCHIVAGE DES ARTEFACTS ET RAPPORTS
        // ==========================================
        stage('Archive') {
            steps {
                echo '=== Archivage des artefacts ==='

                archiveArtifacts artifacts: 'ci-app/target/*.war',
                                  fingerprint: true

                junit allowEmptyResults: false,
                      testResults: 'ci-app/target/surefire-reports/*.xml'
            }
        }
    }

    // ==========================================
    // POST BUILD
    // ==========================================
    post {

        success {
            echo '=== CI SUCCESS ==='
            echo 'Build, tests, analyse SonarQube et déploiement Nexus terminés.'
        }

        failure {
            echo '=== CI FAILURE ==='
            echo 'Une étape du pipeline a échoué.'
        }

        always {
            echo '=== Pipeline CI terminée ==='
        }
    }
}
